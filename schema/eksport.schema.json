{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mapa-socjalu/schema/strona-0.2.json",
  "title": "Kontrakt danych strony strona-0.1 / strona-0.2",
  "description": "Pola zaczynające się od '_' (np. _przyklad, _uwaga) są dopuszczone jako adnotacje pipeline'u i nie są wyświetlane jako dane.",
  "$defs": {
    "data": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "zaslepka": {
      "description": "Wartość, której pipeline jeszcze nie wylicza, np. _do_ustalenia_E5. Strona pokazuje ją jako brak.",
      "type": "string",
      "pattern": "^_do_ustalenia_[A-Za-z0-9]+$"
    },
    "dataLubBrak": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/data"
        },
        {
          "$ref": "#/$defs/zaslepka"
        }
      ]
    },
    "eli": {
      "type": "string",
      "pattern": "^(DU|MP)/\\d{4}/\\d+$"
    },
    "tekst": {
      "type": "string",
      "minLength": 1
    },
    "tekstLubNull": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "adnotacje": {
      "patternProperties": {
        "^_": {}
      }
    },
    "Dowod": {
      "type": "object",
      "required": [
        "eli",
        "przepis",
        "cytat",
        "url",
        "data_stanu"
      ],
      "properties": {
        "eli": {
          "$ref": "#/$defs/eli"
        },
        "przepis": {
          "$ref": "#/$defs/tekst"
        },
        "cytat": {
          "$ref": "#/$defs/tekst"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "data_stanu": {
          "$ref": "#/$defs/dataLubBrak"
        }
      },
      "patternProperties": {
        "^_": {}
      },
      "additionalProperties": false
    },
    "Wariant": {
      "type": "object",
      "required": [
        "etykieta",
        "wartosc"
      ],
      "properties": {
        "etykieta": {
          "$ref": "#/$defs/tekstLubNull"
        },
        "wartosc": {
          "$ref": "#/$defs/tekst"
        }
      },
      "patternProperties": {
        "^_": {}
      },
      "additionalProperties": false
    },
    "Warianty": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Wariant"
          }
        }
      ]
    },
    "Wpis": {
      "type": "object",
      "required": [
        "wartosc",
        "warianty",
        "od",
        "do",
        "rodzaj_zmiany",
        "poprzednia",
        "roznica",
        "dowod"
      ],
      "properties": {
        "wartosc": {
          "$ref": "#/$defs/tekstLubNull"
        },
        "warianty": {
          "$ref": "#/$defs/Warianty"
        },
        "od": {
          "$ref": "#/$defs/dataLubBrak"
        },
        "do": {
          "$ref": "#/$defs/dataLubBrak"
        },
        "rodzaj_zmiany": {
          "enum": [
            "waloryzacja",
            "nowelizacja",
            "akt_wykonawczy",
            "brzmienie_pierwotne",
            "bez_zmiany_kwoty",
            "pierwszy_znany_wpis"
          ]
        },
        "poprzednia": {
          "oneOf": [
            {
              "$ref": "#/$defs/tekstLubNull"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/tekst"
              }
            }
          ]
        },
        "roznica": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "kwota",
                "procent"
              ],
              "properties": {
                "kwota": {
                  "$ref": "#/$defs/tekst"
                },
                "procent": {
                  "$ref": "#/$defs/tekst"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "dowod": {
          "$ref": "#/$defs/Dowod"
        }
      },
      "patternProperties": {
        "^_": {}
      },
      "additionalProperties": false
    },
    "Ile": {
      "type": "object",
      "required": [
        "rozwiazanie",
        "regula",
        "aktualna",
        "kwota_ustawowa_zastapiona",
        "os_czasu",
        "trasa"
      ],
      "properties": {
        "rozwiazanie": {
          "enum": [
            "kwota_w_ustawie",
            "kwota_z_aktu_wykonawczego",
            "regula_procentowa",
            "odeslanie",
            "nieustalone",
            "formula"
          ]
        },
        "regula": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "udzial",
                "podstawa_id",
                "opis"
              ],
              "properties": {
                "udzial": {
                  "$ref": "#/$defs/tekstLubNull"
                },
                "podstawa_id": {
                  "$ref": "#/$defs/tekstLubNull"
                },
                "opis": {
                  "$ref": "#/$defs/tekst"
                },
                "warianty": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "required": [
                          "etykieta",
                          "udzial"
                        ],
                        "properties": {
                          "etykieta": {
                            "$ref": "#/$defs/tekstLubNull"
                          },
                          "udzial": {
                            "$ref": "#/$defs/tekst"
                          }
                        },
                        "additionalProperties": false
                      }
                    }
                  ]
                }
              },
              "patternProperties": {
                "^_": {}
              },
              "additionalProperties": false
            }
          ]
        },
        "aktualna": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "wartosc",
                "od"
              ],
              "properties": {
                "wartosc": {
                  "$ref": "#/$defs/tekstLubNull"
                },
                "warianty": {
                  "$ref": "#/$defs/Warianty"
                },
                "od": {
                  "$ref": "#/$defs/dataLubBrak"
                },
                "do": {
                  "$ref": "#/$defs/dataLubBrak"
                }
              },
              "patternProperties": {
                "^_": {}
              },
              "additionalProperties": false
            }
          ]
        },
        "kwota_ustawowa_zastapiona": {
          "$ref": "#/$defs/tekstLubNull"
        },
        "os_czasu": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Wpis"
          }
        },
        "trasa": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "krok",
              "opis",
              "dowod"
            ],
            "properties": {
              "krok": {
                "type": "integer",
                "minimum": 1
              },
              "opis": {
                "$ref": "#/$defs/tekst"
              },
              "dowod": {
                "$ref": "#/$defs/Dowod"
              }
            },
            "patternProperties": {
              "^_": {}
            },
            "additionalProperties": false
          }
        },
        "progi": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "przepis",
              "wpisy"
            ],
            "properties": {
              "przepis": {
                "$ref": "#/$defs/tekst"
              },
              "wpisy": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Wpis"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "zwiekszenia": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "warunek",
              "kwota",
              "limit",
              "zrodlo",
              "dowod"
            ],
            "properties": {
              "warunek": {
                "$ref": "#/$defs/tekst"
              },
              "kwota": {
                "$ref": "#/$defs/tekst"
              },
              "limit": {
                "$ref": "#/$defs/tekstLubNull"
              },
              "zrodlo": {
                "enum": [
                  "ustawa",
                  "akt_wykonawczy"
                ]
              },
              "dowod": {
                "$ref": "#/$defs/Dowod"
              },
              "dowod_limitu": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/$defs/Dowod"
                  }
                ]
              },
              "nieustalone": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "pole",
                    "powod"
                  ],
                  "properties": {
                    "pole": {
                      "$ref": "#/$defs/tekst"
                    },
                    "powod": {
                      "$ref": "#/$defs/tekst"
                    }
                  },
                  "patternProperties": {
                    "^_": {}
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "wyliczenie": {
          "$ref": "#/$defs/Wyliczenie"
        }
      },
      "patternProperties": {
        "^_": {}
      },
      "additionalProperties": false
    },
    "Termin": {
      "description": "Brak pola rodzaj nie przerywa budowania: termin jest pomijany i zgłaszany w logu (SPEC 5.4).",
      "type": "object",
      "required": [
        "data",
        "opis",
        "skutek",
        "dowod"
      ],
      "properties": {
        "rodzaj": {
          "enum": [
            "okres_kwoty",
            "termin_wniosku",
            "granica_przepisu",
            "okres_zasilkowy",
            "harmonogram_dostepnosci",
            "termin_wyplaty",
            "termin_dokumentu",
            "termin_organu",
            "termin_inny",
            "wejscie_w_zycie"
          ]
        },
        "data": {
          "$ref": "#/$defs/dataLubBrak"
        },
        "opis": {
          "$ref": "#/$defs/tekst"
        },
        "skutek": {
          "$ref": "#/$defs/tekstLubNull"
        },
        "dowod": {
          "$ref": "#/$defs/Dowod"
        },
        "od": {
          "$ref": "#/$defs/dataLubBrak"
        },
        "do": {
          "$ref": "#/$defs/dataLubBrak"
        },
        "okres": {
          "$ref": "#/$defs/tekstLubNull"
        },
        "zdarzenie": {
          "$ref": "#/$defs/tekstLubNull"
        },
        "przepis": {
          "$ref": "#/$defs/tekstLubNull"
        },
        "etapy": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "zakres",
              "od",
              "dowod"
            ],
            "properties": {
              "zakres": {
                "$ref": "#/$defs/tekst"
              },
              "od": {
                "$ref": "#/$defs/dataLubBrak"
              },
              "dowod": {
                "$ref": "#/$defs/Dowod"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "patternProperties": {
        "^_": {}
      },
      "additionalProperties": false
    },
    "Korzysc": {
      "type": "object",
      "required": [
        "id",
        "slug",
        "nazwa",
        "rodzaj_korzysci",
        "status",
        "komu",
        "opis_prosty",
        "sytuacje",
        "przepis",
        "ile",
        "do_kiedy",
        "powiazane",
        "stan",
        "nieustalone"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]+$"
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "nazwa": {
          "$ref": "#/$defs/tekst"
        },
        "rodzaj_korzysci": {
          "enum": [
            "swiadczenie_okresowe",
            "swiadczenie_jednorazowe",
            "ulga_podatkowa",
            "zwolnienie",
            "swiadczenie_rzeczowe",
            "uprawnienie",
            "dofinansowanie"
          ]
        },
        "status": {
          "enum": [
            "obowiazuje",
            "zamknieta",
            "do_ustalenia"
          ]
        },
        "komu": {
          "type": "string"
        },
        "opis_prosty": {
          "$ref": "#/$defs/tekstLubNull"
        },
        "sytuacje": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z_]+$"
          }
        },
        "przepis": {
          "$ref": "#/$defs/Dowod"
        },
        "ile": {
          "$ref": "#/$defs/Ile"
        },
        "do_kiedy": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Termin"
          }
        },
        "powiazane": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "typ",
              "cytat"
            ],
            "properties": {
              "typ": {
                "$ref": "#/$defs/tekst"
              },
              "id_korzysci": {
                "type": "string"
              },
              "przepis": {
                "type": "string"
              },
              "cytat": {
                "$ref": "#/$defs/tekst"
              }
            },
            "patternProperties": {
              "^_": {}
            },
            "additionalProperties": false
          }
        },
        "stan": {
          "type": "object",
          "required": [
            "data_stanu",
            "tekst"
          ],
          "properties": {
            "data_stanu": {
              "$ref": "#/$defs/data"
            },
            "tekst": {
              "const": "tekst ujednolicony (informacyjny)"
            }
          },
          "additionalProperties": false
        },
        "nieustalone": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "pole",
              "powod"
            ],
            "properties": {
              "pole": {
                "$ref": "#/$defs/tekst"
              },
              "powod": {
                "$ref": "#/$defs/tekst"
              }
            },
            "additionalProperties": false
          }
        },
        "flagi": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tekst"
          }
        },
        "sytuacje_zrodlo": {
          "$ref": "#/$defs/tekstLubNull"
        },
        "forma": {
          "enum": ["pieniezne", "niepieniezne", "nieustalona"]
        },
        "obowiazuje_od": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "data",
                "zrodlo",
                "url",
                "uwaga"
              ],
              "properties": {
                "data": {
                  "$ref": "#/$defs/dataLubBrak"
                },
                "zrodlo": {
                  "$ref": "#/$defs/tekst"
                },
                "url": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "uri"
                },
                "uwaga": {
                  "$ref": "#/$defs/tekstLubNull"
                }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "patternProperties": {
        "^_": {}
      },
      "additionalProperties": false
    },
    "Plik": {
      "type": "object",
      "required": [
        "rodzaj",
        "plik",
        "nazwa_pobierania",
        "sha256",
        "rozmiar",
        "url_zrodla",
        "pobrano",
        "data_stanu",
        "eli_obwieszczenia",
        "uzyty_w_danych"
      ],
      "properties": {
        "rodzaj": {
          "enum": [
            "U",
            "O",
            "TJ"
          ]
        },
        "plik": {
          "type": "string",
          "pattern": "^akty/[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*\\.pdf$"
        },
        "nazwa_pobierania": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "rozmiar": {
          "type": "integer",
          "minimum": 1
        },
        "url_zrodla": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "pobrano": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "data_stanu": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/data"
            }
          ]
        },
        "eli_obwieszczenia": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/eli"
            }
          ]
        },
        "uzyty_w_danych": {
          "type": "boolean"
        },
        "warstwa_tekstowa": {
          "$ref": "#/$defs/tekstLubNull"
        },
        "zrodlo": {
          "$ref": "#/$defs/tekstLubNull"
        },
        "tekst_naprawiony": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "plik",
                "sha256",
                "rozmiar",
                "mapa_znakow",
                "pochodny"
              ],
              "properties": {
                "plik": {
                  "$ref": "#/$defs/tekst"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "rozmiar": {
                  "type": "integer",
                  "minimum": 1
                },
                "mapa_znakow": {
                  "$ref": "#/$defs/tekst"
                },
                "pochodny": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "patternProperties": {
        "^_": {}
      },
      "additionalProperties": false
    },
    "Akt": {
      "type": "object",
      "required": [
        "eli",
        "tytul",
        "typ",
        "data_stanu",
        "url_eli",
        "url_isap",
        "korzysci",
        "wykonawcze",
        "status",
        "pliki"
      ],
      "properties": {
        "eli": {
          "$ref": "#/$defs/eli"
        },
        "tytul": {
          "$ref": "#/$defs/tekst"
        },
        "typ": {
          "$ref": "#/$defs/tekst"
        },
        "data_stanu": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/data"
            }
          ]
        },
        "url_eli": {
          "type": "string",
          "format": "uri"
        },
        "url_isap": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "korzysci": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "wykonawcze": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "eli",
              "tytul",
              "od"
            ],
            "properties": {
              "eli": {
                "$ref": "#/$defs/eli"
              },
              "tytul": {
                "$ref": "#/$defs/tekst"
              },
              "od": {
                "$ref": "#/$defs/dataLubBrak"
              }
            },
            "patternProperties": {
              "^_": {}
            },
            "additionalProperties": false
          }
        },
        "status": {
          "$ref": "#/$defs/tekst"
        },
        "pliki": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Plik"
          }
        }
      },
      "patternProperties": {
        "^_": {}
      },
      "additionalProperties": false
    },
    "Slowniki": {
      "type": "object",
      "required": [
        "rodzaj_korzysci",
        "rodzaj_terminu",
        "status",
        "sytuacje"
      ],
      "properties": {
        "rodzaj_korzysci": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/tekst"
          }
        },
        "rodzaj_terminu": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/tekst"
          }
        },
        "status": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/tekst"
          }
        },
        "sytuacje": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/tekst"
          }
        }
      },
      "patternProperties": {
        "^_": {}
      },
      "additionalProperties": false
    },
    "Manifest": {
      "type": "object",
      "required": [
        "kontrakt",
        "wygenerowano",
        "wersja_kodu",
        "zakres"
      ],
      "properties": {
        "kontrakt": {
          "enum": [
            "strona-0.1",
            "strona-0.2",
            "strona-0.3",
            "strona-0.4"
          ]
        },
        "wygenerowano": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}(T.*)?$"
        },
        "wersja_kodu": {
          "$ref": "#/$defs/tekst"
        },
        "pliki": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "zakres": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/eli"
          }
        },
        "na_dzien": {
          "$ref": "#/$defs/data"
        },
        "z_plikami_pdf": {
          "type": "boolean"
        },
        "liczby": {
