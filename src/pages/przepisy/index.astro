---
import Uklad from '../../layouts/Uklad.astro';
import { dane } from '../../lib/model.mjs';
import { socjal } from '../../lib/socjal.mjs';
import { eliSlug } from '../../lib/format.mjs';
const d = socjal();
const akty = dane().akty;
const grupy = (d?.artykuly ?? []).reduce((res: any, a: any) => {
 (res[a.eli] ??= []).push(a); return res;
}, {} as Record<string, any[]>);
---
<Uklad tytul="Mapa przepisów" opis="Artykuły przepisów opisane w projekcie Socjal, ich jednostki oraz powiązane świadczenia.">
  <div class="page-head"><div class="wrap"><nav class="breadcrumb"><a href="/">Strona główna</a><span>/</span><span>Mapa przepisów</span></nav><p class="kicker">Źródła i zależności</p><h1>Mapa przepisów</h1><p class="lead">{d?.artykuly.length ?? 0} artykułów w aktualnym zbiorze danych. Zobacz treść jednostek, odwołania pomiędzy artykułami i przypisane karty.</p><p class="summary-note">Automatyczna analiza przepisów nie jest samodzielną weryfikacją obowiązywania prawa w danym dniu.</p></div></div>
  <div class="wrap section">
    {!d && <p class="summary-note">Brak nowego eksportu z projektu Socjal.</p>}
    {Object.entries(grupy).map(([eli, lista]) => <section class="detail-section"><h2><a class="link" href={`/akt/${eliSlug(eli)}/`}>{akty.find((x: any) => x.eli === eli)?.tytul ?? eli}</a></h2><p>{eli}: {(lista as any[]).length} artykułów</p><div class="tag-list" style="display:flex;flex-wrap:wrap;gap:8px">{(lista as any[]).map((a: any) => <a class="tag" href={`/przepis/${a.id}/`}>art. {a.artykul}</a>)}</div></section>)}
  </div>
</Uklad>
