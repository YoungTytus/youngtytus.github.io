---
// Podstrona „Liczby”: ile państwo wydaje na socjal. Koncept v3 (raport-fdr):
// Raport_Socjal_Wydatki/Strona/Koncept podstrony Liczby v3 (raport-fdr).md. Od ogółu do szczegółu, każdy
// obiekt ma numer i wiersz źródłowy. Dane wyłącznie z data/liczby/liczby.json; strona tylko formatuje
// i robi proste działania na polach (suma, różnica, iloraz), oznaczone jako obliczenia własne.
import Uklad from '../../layouts/Uklad.astro';
import { korzyscPoId } from '../../lib/model.mjs';
import {
  KARTY_PROGRAMOW, kodProgramu, liczba, liczby, mapaPowiatow, mediana, mld, nazwaKrotka, naMieszkanca, proc, sumaRok, tp,
  wzrostCen, zl,
} from '../../lib/liczby.mjs';

const d = liczby();
if (!d) return Astro.redirect('/');

const ROK = 2025;
const s25 = sumaRok(d, ROK);
const s20 = sumaRok(d, 2020);
const naOs = naMieszkanca(d, ROK);
const bez = d.bez_emerytur_zus_2025;
const ceny = wzrostCen(d);
const fakt = (id: string) => d.fakty.find((f: any) => f.id === id);
const M1realnie = ceny ? ((s25.transfery_mld / s20.transfery_mld) / ceny.czynnik - 1) * 100 : null;
const cofogLata = Object.keys(d.cofog10).filter((k) => /^\d{4}$/.test(k)).sort();
const cofogOst = cofogLata.length ? { rok: cofogLata[cofogLata.length - 1], ...d.cofog10[cofogLata[cofogLata.length - 1]] } : null;
const zgodnosc = d.suma.filter((s: any) => s.razem_z_uslugami_jst_mld && s.cofog10_sektor_mld).map((s: any) => (s.razem_z_uslugami_jst_mld / s.cofog10_sektor_mld) * 100);
const dlug = fakt('dlug_vs_800');
const rozp = fakt('rozpietosc_powiatow');
const jst = d.jst_bilans_mld;
const wlasne = jst['środki własne JST (wydatki - transfery)'];
const lataJst = Object.keys(wlasne).sort();
const jstWydatki = jst['wydatki 852+853+855'];
const esc = (s: string) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;');
const ZR = {
  mf: 'MF, Sprawozdanie z wykonania budżetu państwa',
  rb: 'MF, sprawozdania Rb-28S i Rb-27S samorządów, IV kw.',
  cofog: d.cofog10.zrodlo ?? 'MF, Informacja kwartalna o stanie finansów publicznych (COFOG 10)',
  gus: 'GUS, CPI średnioroczne',
};

// ---------- programy ----------
const lataProg = Object.keys(d.programy[0].mld).sort();
const programy = d.programy.map((p: any, i: number) => ({
  ...p, i, krotka: nazwaKrotka(p.nazwa), kod: kodProgramu(p.nazwa),
  karty: (KARTY_PROGRAMOW as Record<string, string[]>)[p.nazwa]?.map((id) => korzyscPoId(id)).filter(Boolean) ?? [],
}));
const duze = programy.filter((p: any) => (p.mld[String(ROK)] ?? 0) > 20 && p.wzrost_realny_proc != null)
  .sort((a: any, b: any) => b.wzrost_realny_proc - a.wzrost_realny_proc).slice(0, 3);
const wg2025 = [...programy].sort((a: any, b: any) => (b.mld[String(ROK)] ?? 0) - (a.mld[String(ROK)] ?? 0));
const maxProg = wg2025[0].mld[String(ROK)];
const realne = programy.filter((p: any) => p.wzrost_realny_proc != null).sort((a: any, b: any) => b.wzrost_realny_proc - a.wzrost_realny_proc);
const rMin = Math.min(0, ...realne.map((p: any) => p.wzrost_realny_proc)), rMax = Math.max(...realne.map((p: any) => p.wzrost_realny_proc));
const rZero = (-rMin / (rMax - rMin)) * 100;

// ---------- Wykres 1 ----------
const KOL = { navy: '#0b1f3a', nieb: '#15345c', nieb2: '#6f8db5', pom: '#c8102e', siatka: '#dde4ec', tekst: '#4f5a6b' };
const lata = d.suma.map((s: any) => s.rok);
const przybl = d.suma.filter((s: any) => /przybli/i.test(s.metoda)).map((s: any) => s.rok);
const tylkoCeny = ceny ? s20.transfery_mld * ceny.czynnik : null;
function wykres1() {
  const W = 760, H = 330, L = 52, R = 170, T = 32, B = 36;
  const ymax = Math.ceil(Math.max(...d.suma.map((s: any) => Math.max(s.transfery_mld, s.razem_z_uslugami_jst_mld ?? 0))) / 100) * 100;
  const X = (r: number) => L + ((r - lata[0]) / (lata[lata.length - 1] - lata[0])) * (W - L - R);
  const Y = (v: number) => T + (1 - v / ymax) * (H - T - B);
  const cz: string[] = [];
  for (let v = 0; v <= ymax; v += 100) cz.push(`<line x1="${L}" x2="${W - R}" y1="${Y(v)}" y2="${Y(v)}" stroke="${KOL.siatka}"/><text x="${L - 8}" y="${Y(v) + 4}" text-anchor="end" font-size="12" fill="${KOL.tekst}">${v}</text>`);
  lata.forEach((r: number) => cz.push(`<text x="${X(r)}" y="${H - B + 22}" text-anchor="middle" font-size="12" fill="${KOL.tekst}">${r}</text>`));
  cz.push(`<text x="${L - 8}" y="${T - 16}" text-anchor="end" font-size="11" fill="${KOL.tekst}">mld zł</text>`);
  const linia = (pkt: number[][], k: string, przer: boolean, gr = 3) => `<polyline points="${pkt.map(([r, v]) => `${X(r)},${Y(v)}`).join(' ')}" fill="none" stroke="${k}" stroke-width="${gr}" ${przer ? 'stroke-dasharray="6 6"' : ''} stroke-linejoin="round"/>`;
  const kropki = (pkt: number[][], k: string) => pkt.map(([r, v]) => `<circle cx="${X(r)}" cy="${Y(v)}" r="4" fill="${k}" stroke="#fff" stroke-width="1.5"/>`).join('');
  const m1 = d.suma.map((s: any) => [s.rok, s.transfery_mld]);
  const ostP = Math.max(...przybl);
  const m2 = d.suma.filter((s: any) => s.razem_z_uslugami_jst_mld != null).map((s: any) => [s.rok, s.razem_z_uslugami_jst_mld]);
  if (tylkoCeny) cz.push(linia([[lata[0], s20.transfery_mld], [ROK, tylkoCeny]], KOL.pom, true, 2), `<circle cx="${X(ROK)}" cy="${Y(tylkoCeny)}" r="4" fill="#fff" stroke="${KOL.pom}" stroke-width="2"/>`);
  cz.push(linia(m1.filter(([r]: number[]) => r <= ostP + 1), KOL.nieb2, true), linia(m1.filter(([r]: number[]) => r > ostP), KOL.nieb2, false), kropki(m1, KOL.nieb2));
  cz.push(linia(m2, KOL.navy, false, 3.5), kropki(m2, KOL.navy));
  const podp = [
    { y: Y(m2[m2.length - 1][1]), t: `M2: ${liczba(m2[m2.length - 1][1], 1)}`, k: KOL.navy },
    { y: Y(m1[m1.length - 1][1]), t: `M1: ${liczba(m1[m1.length - 1][1], 1)}`, k: KOL.nieb2 },
    ...(tylkoCeny ? [{ y: Y(tylkoCeny), t: `jak ceny: ${liczba(tylkoCeny, 1)}`, k: KOL.pom }] : []),
  ].sort((a, b) => a.y - b.y);
  podp.forEach((p, i) => { if (i && p.y - podp[i - 1].y < 16) p.y = podp[i - 1].y + 16; });
  podp.forEach((p) => cz.push(`<text x="${W - R + 10}" y="${p.y + 4}" font-size="12.5" font-weight="700" fill="${p.k}">${esc(p.t)}</text>`));
  return { svg: cz.join(''), W, H };
}
const w1 = wykres1();

// ---------- Tabela 2 ----------
const SOCJALNE = new Set(['753', '852', '853', '854', '855']);
const dzialy = [...d.dzialy_budzetu].sort((a: any, b: any) => b['2025_mld'] - a['2025_mld']);
const top10 = dzialy.slice(0, 10);
const reszta = dzialy.slice(10);
const resztaWiersz: any = {
  nazwa: `Pozostałe działy (${reszta.length})`, kod: null,
  '2020_mld': reszta.reduce((a: number, x: any) => a + x['2020_mld'], 0), '2025_mld': reszta.reduce((a: number, x: any) => a + x['2025_mld'], 0),
  udzial_2025_proc: reszta.reduce((a: number, x: any) => a + x.udzial_2025_proc, 0), zmiana_realna_2020_2025_proc: null,
};
if (ceny && resztaWiersz['2020_mld'] > 0) resztaWiersz.zmiana_realna_2020_2025_proc = (resztaWiersz['2025_mld'] / resztaWiersz['2020_mld'] / ceny.czynnik - 1) * 100;
const dz = (kod: string) => d.dzialy_budzetu.find((x: any) => x.kod === kod);
const udzSocjal = d.kontrole.dzialy_socjalne_2025_udzial_bp_proc;

// ---------- Tabela 3 ----------
const platnicy = Object.entries(d.platnicy_2022_2025_mld) as [string, Record<string, number>][];
const lataP = Object.keys(platnicy[0][1]).sort();
const nazwaPlatnika = (n: string) => n.replace(/^FUS: .*/, 'ZUS: emerytury, renty, zasiłki (FUS)').replace(/^FER \(KRUS\).*/, 'KRUS: emerytury i renty rolnicze (FER)')
  .replace(/^FEP: .*/, 'Emerytury pomostowe (FEP)').replace(/^Fundusz Solidarnościowy.*/, 'Fundusz Solidarnościowy (FS)').replace(/^Fundusz Pracy.*/, 'Fundusz Pracy: zasiłki i świadczenia')
  .replace(/^Budżet państwa.*/, 'Budżet państwa: świadczenia dla osób (753, 851-855)').replace(/^JST: świadczenia.*/, 'Samorządy: świadczenia w gotówce (§ 3110)')
  .replace(/^JST: usługi.*/, 'Samorządy: usługi (OPS, DPS, piecza, żłobki)');
const sumaUdzialow = (Object.values(d.udzialy_platnikow_2025_proc) as number[]).reduce((x, y) => x + y, 0);
const sumaP = (r: string) => platnicy.reduce((a, [, v]) => a + (v[r] ?? 0), 0);

// ---------- Tabele 5 i 6 ----------
const wiersz = (n: string) => jst[n] ?? {};
const dotacjeBP = Object.fromEntries(lataJst.map((r) => [r, ['dochody 852/853/855: dotacja_zadania_zlecone', 'dochody 852/853/855: dotacja_zadania_wlasne', 'dochody 852/853/855: dotacja_porozumienia_z_administracja'].reduce((a, n) => a + (wiersz(n)[r] ?? 0), 0)]));
const transfery = wiersz('dochody 852/853/855: transfery razem');
const g3110 = wiersz('w tym § 3110 świadczenia społeczne');
const bilans: any[] = [
  { n: 'Pomoc społeczna (dział 852)', v: wiersz('wydatki 852') },
  { n: 'Pozostałe zadania polityki społecznej (853)', v: wiersz('wydatki 853') },
  { n: 'Rodzina (855)', v: wiersz('wydatki 855') },
  { n: 'Wydatki razem (852, 853, 855)', v: jstWydatki, mocny: true },
  { n: 'w tym świadczenia w gotówce (§ 3110)', v: g3110, wciecie: true },
  { n: 'w tym usługi i pozostałe wydatki', v: Object.fromEntries(lataJst.map((r) => [r, jstWydatki[r] - (g3110[r] ?? 0)])), wciecie: true, wlasne: true },
  { n: 'Dotacje z budżetu państwa', v: dotacjeBP, wlasne: true },
  { n: 'Inne transfery (fundusze, UE, inne samorządy)', v: Object.fromEntries(lataJst.map((r) => [r, transfery[r] - dotacjeBP[r]])), wlasne: true },
  { n: 'Transfery razem', v: transfery },
  { n: 'Środki własne samorządów', v: wlasne, odniesienie: true },
];
const rozdzialy = [...d.jst_rozdzialy_mld].sort((a: any, b: any) => b[String(ROK)] - a[String(ROK)]).slice(0, 10);

// ---------- mapa, Tabele 7 i 8 ----------
const latMapy = [...new Set(d.powiaty.map((p: any) => p.rok))].sort() as number[];
const rokMapy = latMapy[latMapy.length - 1];
const pow25 = d.powiaty.filter((p: any) => p.rok === rokMapy).sort((a: any, b: any) => b.jst_socjal_zl_os - a.jst_socjal_zl_os);
const medianaPow = mediana(pow25.map((p: any) => p.jst_socjal_zl_os));
const woj25 = d.wojewodztwa.filter((w: any) => w.rok === rokMapy).sort((a: any, b: any) => b.jst_socjal_zl_os - a.jst_socjal_zl_os);
const nazwaWoj = (t: string) => d.wojewodztwa.find((w: any) => w.teryt === t)?.nazwa ?? t;
const mapa = mapaPowiatow(1000);
const daneMapy = {
  woj: d.wojewodztwa.map((w: any) => [w.teryt, w.nazwa, w.rok, w.jst_socjal_zl_os, w.jst_swiadczenia_gotowka_zl_os ?? null, w.jst_srodki_wlasne_zl_os, w.ludnosc]),
  pow: d.powiaty.map((p: any) => [p.teryt, p.nazwa, p.rok, p.jst_socjal_zl_os, null, p.jst_srodki_wlasne_zl_os, p.ludnosc]),
  mediana: Object.fromEntries(latMapy.flatMap((r) => [
    [String(r), { 3: mediana(d.powiaty.filter((p: any) => p.rok === r).map((p: any) => p.jst_socjal_zl_os)), 5: mediana(d.powiaty.filter((p: any) => p.rok === r).map((p: any) => p.jst_srodki_wlasne_zl_os)) }],
    [`w${r}`, { 3: mediana(d.wojewodztwa.filter((w: any) => w.rok === r).map((w: any) => w.jst_socjal_zl_os)), 4: mediana(d.wojewodztwa.filter((w: any) => w.rok === r).map((w: any) => w.jst_swiadczenia_gotowka_zl_os)), 5: mediana(d.wojewodztwa.filter((w: any) => w.rok === r).map((w: any) => w.jst_srodki_wlasne_zl_os)) }],
  ])),
};
const wojLista = [...woj25].sort((a: any, b: any) => a.nazwa.localeCompare(b.nazwa, 'pl'));

// ---------- Tabela 9 ----------
const fs = d.fundusz_solidarnosciowy;
const p1314 = programy.find((p: any) => /^13\./.test(p.nazwa));
const zdarzenia = (rok: number) => [
  ...fs.pozyczki.filter((p: any) => p.rok === rok).map((p: any) => `pożyczka ${mld(p.tys_zl / 1e6)} od: ${p.od} (${p.zrodlo})`),
  ...Object.entries(fs.stan_funduszu_mld).filter(([k]) => k.endsWith(String(rok))).map(([k, v]) => `stan funduszu (${k}): ${mld(v as number)}`),
  ...Object.entries(fs.zobowiazania_z_pozyczek_mld).filter(([k]) => k.endsWith(String(rok))).map(([k, v]) => `zobowiązania z pożyczek (${k}): ${mld(v as number)}`),
];
const kto = (rok: number) => (rok <= 2023 ? 'Fundusz Solidarnościowy' : 'budżet państwa (rozdział 75313)');

const SEKCJE = [['skrot', 'W skrócie'], ['czas', 'Całość w czasie'], ['panstwo', 'Na tle państwa'], ['kto', 'Kto wypłaca'], ['naco', 'Na co'],
  ['samorzady', 'Samorządy'], ['mapa', 'Mapa i regiony'], ['fs', 'Z bliska: Fundusz Solidarnościowy'], ['dane', 'O danych']];
const kpi = {
  pelna: [mld(s25.razem_z_uslugami_jst_mld), zl(naOs), `wydatki socjalne ${ROK}, co najmniej`],
  bez: [mld(bez.mld), zl(bez.zl_na_mieszkanca), `wydatki socjalne ${ROK} bez emerytur i rent ZUS`],
};
const opisSeo = tp(`Ile kosztuje socjal w Polsce: co najmniej ${mld(s25.razem_z_uslugami_jst_mld)} w ${ROK} r., ${zl(naOs)} na mieszkańca. Kto wypłaca, na co, ile wydaje Twój samorząd. Każda liczba ze źródłem.`);
---
<Uklad tytul="Liczby: ile kosztuje socjal w Polsce" opis={opisSeo} sekcja="liczby">
<div class="page-head">
  <div class="wrap">
    <nav class="breadcrumb" aria-label="Ścieżka nawigacji"><a href="/">Strona główna</a><span aria-hidden="true">/</span><span aria-current="page">Liczby</span></nav>
    <h1>Ile kosztuje socjal w Polsce</h1>
    <p class="lead">{tp(`W ${ROK} r. na świadczenia i usługi socjalne wydano co najmniej ${mld(s25.razem_z_uslugami_jst_mld)}. W latach ${lata[0]}-${ROK} transfery pieniężne do ludzi wzrosły realnie o ${proc(M1realnie)}. Część wypłat (13. i 14. emerytura w latach 2020-2023) finansowano z funduszu, który zadłużał się pożyczkami.`)}</p>
    <p class="legal-status lz-stan"><span>{tp(`Wykonanie budżetu i sprawozdania samorządów za ${lata[0]}-${ROK}. Dane z ${d.meta.wygenerowano.split('-').reverse().join('.')}.`)} <a class="link" href="#dane">Skąd liczby</a></span></p>
  </div>
</div>

<div class="wrap lz-start" aria-live="polite">
  <div class="amount-panel lz-glowna">
    <p class="eyebrow" data-kpi="2">{kpi.pelna[2]}</p>
    <p class="lz-glowna-liczba" data-kpi="0">{kpi.pelna[0]}</p>
    <p class="lz-glowna-os"><strong data-kpi="1">{kpi.pelna[1]}</strong> na mieszkańca</p>
    <div class="lz-segment" role="group" aria-label="Definicja socjalu">
      <button type="button" aria-pressed="true" data-wariant="pelna">z emeryturami ZUS</button>
      <button type="button" aria-pressed="false" data-wariant="bez">bez emerytur i rent ZUS</button>
    </div>
  </div>
  <div class="lz-statystyki">
    <div class="lz-stat"><span class="type">Realny wzrost transferów</span><strong>{proc(M1realnie, 1, true)}</strong><span>{lata[0]}-{ROK}, w cenach {ROK}</span></div>
    {cofogOst && <div class="lz-stat"><span class="type">Ochrona socjalna</span><strong>{proc(cofogOst.proc_pkb)} PKB</strong><span>{proc(cofogOst.proc_wydatkow_sektora, 0)} wydatków publicznych, {cofogOst.rok}</span></div>}
    <div class="lz-stat"><span class="type">Tempo wydatków</span><strong>{liczba(d.licznik_2025.zl_na_sekunde)} zł</strong><span>na sekundę; od otwarcia strony: <span id="licznik" data-tempo={d.licznik_2025.zl_na_sekunde}>0</span> zł</span></div>
  </div>
  <script type="application/json" id="kpi" set:html={JSON.stringify(kpi)} />
</div>

<div class="wrap section detail-layout lz-uklad">
  <nav class="detail-nav lz-spis" aria-label="Na tej stronie">
    {SEKCJE.map(([id, t]) => <a href={`#${id}`}>{t}</a>)}
  </nav>

  <div class="detail-content">
      <section id="skrot" class="detail-section lz-sek" aria-labelledby="h-skrot">
        <p class="kicker">W skrócie</p>
        <h2 id="h-skrot">Cztery najważniejsze ustalenia</h2>
        <div class="lz-wnioski">
          <div class="principle"><span class="principle-num">01</span><div><h3>{tp(`Co najmniej ${mld(s25.razem_z_uslugami_jst_mld)} w ${ROK} r., czyli ${zl(naOs)} na mieszkańca.`)}</h3><p>{tp(`Bez emerytur i rent ZUS: ${mld(bez.mld)} (${zl(bez.zl_na_mieszkanca)} na mieszkańca).`)}</p></div></div>
          <div class="principle"><span class="principle-num">02</span><div><h3>{tp(`Transfery wzrosły realnie o ${proc(M1realnie)} w pięć lat.`)}</h3><p>{tp(`Wśród największych programów najszybciej rosły wydatki w pozycjach: ${duze.map((p: any) => `${/^\d/.test(p.krotka) ? p.krotka : p.krotka.charAt(0).toLocaleLowerCase('pl') + p.krotka.slice(1)} (${proc(p.wzrost_realny_proc, 0, true)})`).join(', ')}. To wydatki ogółem, nie kwota świadczenia na osobę.`)}</p></div></div>
          <div class="principle"><span class="principle-num">03</span><div><h3>{cofogOst && tp(`Ochrona socjalna to ${proc(cofogOst.proc_wydatkow_sektora, 0)} wszystkich wydatków publicznych i ${proc(cofogOst.proc_pkb)} PKB (COFOG, ${cofogOst.rok}).`)}</h3><p>{dlug && tp(`W budżecie państwa obsługa długu (${mld(dlug.liczby.obsluga_dlugu_mld)}) kosztuje więcej niż 800+ i 13. i 14. emerytura razem (${mld(dlug.liczby.suma_800_13_14_mld)}).`)}</p></div></div>
          <div class="principle"><span class="principle-num">04</span><div><h3>{rozp && tp(`W powiecie o najwyższych wydatkach samorządy wydają na socjal ${liczba(rozp.liczby.max_zl_os / rozp.liczby.min_zl_os, 1)} raza więcej na mieszkańca niż w powiecie o najniższych.`)}</h3><p>{tp(`Własne pieniądze samorządów na socjal wzrosły w latach ${lataJst[0]}-${lataJst[lataJst.length - 1]} z ${mld(wlasne[lataJst[0]])} do ${mld(wlasne[lataJst[lataJst.length - 1]])}.`)}</p></div></div>
        </div>

        <aside class="lz-ramka">
          <p><strong>O danych:</strong> {tp(`Suma jest dolną granicą: nie obejmuje NFZ, funduszy BGK ani ulg podatkowych. Pokazujemy dwie liczby, z emeryturami i rentami ZUS i bez nich, bo emerytury są świadczeniem składkowym. Nasza suma to ${liczba(Math.min(...zgodnosc))}-${liczba(Math.max(...zgodnosc))} % wydatków na ochronę socjalną według MF (COFOG 10).`)}</p>
        </aside>
      </section>

