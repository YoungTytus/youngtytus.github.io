        {d.fundusz_solidarnosciowy.pozyczki.map((p: any) => <li><strong>{p.rok}:</strong> pożyczka {mld(p.tys_zl / 1e6, 1)} od: {p.od} <span class="muted">({p.zrodlo})</span></li>)}
        {Object.entries(d.fundusz_solidarnosciowy.stan_funduszu_mld).map(([k, v]) => <li>Stan funduszu ({k}): <strong>{mld(v as number)}</strong></li>)}
        {Object.entries(d.fundusz_solidarnosciowy.zobowiazania_z_pozyczek_mld).map(([k, v]) => <li>Zobowiązania z pożyczek ({k}): <strong>{mld(v as number)}</strong></li>)}
      </ul>
    </aside>
  </section>

  <section class="section section-soft" aria-labelledby="lz-tlo">
    <div class="wrap">
