          <ul class="lz-skala" id="skala" aria-label="Legenda: przedziały w zł na mieszkańca"></ul>
          <p class="summary-note">Kliknij województwo, żeby zobaczyć jego powiaty. Kolor: pięć przedziałów, w każdym podobna liczba jednostek. Granice: PRG, GUGiK (dane otwarte, pobrane {mapa.meta.pobrano}), uproszczone do {liczba(mapa.meta.tolerancja_m)} m.</p>
        </div>
      )}
    </div>
    <p class="lz-uwaga"><Ikona n="tarcza" />Mapa pokazuje wydatki samorządów ({mld(jstRazem, 0)} z {mld(s25.razem_z_uslugami_jst_mld, 0)}). Emerytury ZUS i 800+ są wypłacane centralnie i nie mają podziału na powiaty.</p>
    <script type="application/json" id="dane-mapy" set:html={JSON.stringify(daneMapy)} />
  </section>

  <section class="section section-soft" aria-labelledby="lz-sprawdz">
    <div class="wrap">
      <p class="kicker">Sprawdź nas</p>
      <h2 id="lz-sprawdz">Każda liczba ma źródło.</h2>
      <p class="lz-lead">Naszą sumę porównujemy z niezależną liczbą Ministerstwa Finansów: wydatkami na ochronę socjalną (COFOG 10). Zgodność w latach {zgodnosc.map((z: any) => z.rok).join(', ')}: {liczba(zgMin)}–{liczba(zgMax)}%.</p>
      <div class="lz-dwie">
        <div>
          <h3>Jak liczymy</h3>
          <ol class="lz-metoda">
            <li>Liczymy wypłaty u faktycznego płatnika: ZUS, KRUS, fundusze, budżet państwa, samorządy.</li>
            <li>Dotacji przekazywanych między nimi nie liczymy drugi raz.</li>
            <li>Źródła: sprawozdania MF z wykonania budżetu, sprawozdania samorządów, ludność i inflacja z GUS.</li>
            <li>Wynik porównujemy z liczbą MF dla ochrony socjalnej (COFOG 10).</li>
            <li>Suma jest dolną granicą: nie obejmuje NFZ, funduszy BGK ani ulg podatkowych.</li>
          </ol>
          <h3>Zastrzeżenia</h3>
          <ul>{d.meta.zastrzezenia.map((z: string) => <li>{z}</li>)}</ul>
        </div>
        <div>
          <h3>Źródła</h3>
          <ul>{d.meta.zrodla.map((z: string) => <li>{z}</li>)}</ul>
          <h3>Pobierz dane</h3>
          <p><a class="btn btn-sm" href="/dane/liczby.json" download="liczby.json"><Ikona n="pobierz" />liczby.json</a> <a class="btn btn-sm" href="/dane/liczby-programy.csv" download><Ikona n="pobierz" />Programy (CSV)</a> <a class="btn btn-sm" href="/dane/liczby-powiaty.csv" download><Ikona n="pobierz" />Powiaty (CSV)</a></p>
          <p class="summary-note">Wersja danych {d.meta.wersja}, wygenerowano {d.meta.wygenerowano}. SHA-256 pliku: <code class="lz-sha">{d._sha256}</code></p>
        </div>
      </div>
    </div>
  </section>

  <script type="application/json" id="dane-liczb" set:html={JSON.stringify(daneKlienta)} />
</Uklad>

<script>
  const NBSP = ' ';
  const fmt = (v: number) => Math.round(v).toString().replace(/\B(?=(\d{3})+(?!\d))/g, NBSP);
  const dane = JSON.parse(document.getElementById('dane-liczb')!.textContent!);

  // licznik: od otwarcia strony, tempo z pliku; bez ciasteczek
  const start = performance.now();
  const el = document.getElementById('licznik')!;
  const tik = () => { el.textContent = fmt(((performance.now() - start) / 1000) * dane.zlNaSek); };
  setInterval(tik, matchMedia('(prefers-reduced-motion: reduce)').matches ? 1000 : 100);

  // przełącznik „bez emerytur ZUS”
  const bez = document.getElementById('bez-zus') as HTMLInputElement;
  const osoby = document.getElementById('osoby') as HTMLSelectElement;
  const wynik = document.getElementById('kalk-wynik')!;
  const kalk = () => { wynik.textContent = `${fmt(Number(osoby.value) * (bez.checked ? dane.bezNaOs : dane.naOs))}${NBSP}zł`; };
  bez.addEventListener('change', () => {
    document.querySelectorAll<HTMLElement>('[data-pelna]').forEach((e) => { e.hidden = bez.checked; });
    document.querySelectorAll<HTMLElement>('[data-bez]').forEach((e) => { e.hidden = !bez.checked; });
    kalk();
  });
  osoby.addEventListener('change', kalk);

  // mapa powiatów (granice PRG) i ranking; poziom województw albo powiatów
  type Wiersz = [string, string, number, number | null, number | null, number | null, number];
  const m = JSON.parse(document.getElementById('dane-mapy')!.textContent!) as { woj: Wiersz[]; pow: Wiersz[]; mediana: Record<string, Record<string, number>> };
  const miara = document.getElementById('mapa-miara') as HTMLSelectElement;
  const rok = document.getElementById('mapa-rok') as HTMLSelectElement;
  const wojSel = document.getElementById('mapa-woj') as HTMLSelectElement;
  const szukaj = document.getElementById('szukaj-powiat') as HTMLInputElement;
  const ranking = document.getElementById('ranking')!;
  const ile = document.getElementById('ranking-ile')!;
  const wiecej = document.getElementById('ranking-wiecej') as HTMLButtonElement;
  const filtrInfo = document.getElementById('powiat-filtr')!;
  const skala = document.getElementById('skala');
  const mapa = document.getElementById('mapa') as SVGSVGElement | null;
  const poziomInfo = document.getElementById('mapa-poziom');
  const dymek = document.getElementById('dymek');
  const sciezki = mapa ? [...mapa.querySelectorAll<SVGPathElement>('#mapa-pow path')] : [];
  const KOLORY = ['#e3eaf3', '#b9cbe2', '#7f9fc7', '#3d6496', '#0b1f3a'];
  let wojFiltr: string | null = null;
  let wszystkie = false;
  let stan: Record<string, { nazwa: string; v: number | null; miejsce: number; z: number; wojNazwa?: string }> = {};
  let medianaTeraz = 0;
  const norm = (s: string) => s.toLocaleLowerCase('pl').replace(/ł/g, 'l').normalize('NFD').replace(/[̀-ͯ]/g, '');
  const progi = (w: number[]) => { const s = [...w].sort((a, b) => a - b); return [1, 2, 3, 4].map((i) => s[Math.floor((i * s.length) / 5)]); };
  const klasa = (v: number, p: number[]) => p.filter((x) => v >= x).length;
  const nazwaWoj = (t: string) => m.woj.find((w) => w[0] === t)?.[1] ?? t;

  function zoom() {
    if (!mapa) return;
    if (!wojFiltr) { mapa.setAttribute('viewBox', mapa.dataset.pelny!); return; }
    const b = sciezki.filter((p) => p.dataset.t!.startsWith(wojFiltr!)).map((p) => p.getBBox());
    const x0 = Math.min(...b.map((r) => r.x)), y0 = Math.min(...b.map((r) => r.y));
    const x1 = Math.max(...b.map((r) => r.x + r.width)), y1 = Math.max(...b.map((r) => r.y + r.height));
    const pad = Math.max(x1 - x0, y1 - y0) * 0.06;
    mapa.setAttribute('viewBox', `${x0 - pad} ${y0 - pad} ${x1 - x0 + 2 * pad} ${y1 - y0 + 2 * pad}`);
  }

  function rysuj() {
    const k = Number(miara.value), r = Number(rok.value);
    const kp = k === 4 ? 3 : k; // „gotówka” jest tylko dla województw
    const poziomPow = !!wojFiltr && k !== 4;
    const woj = m.woj.filter((w) => w[2] === r && w[k] != null).sort((a, b) => (b[k] as number) - (a[k] as number));
    const pow = m.pow.filter((x) => x[2] === r && x[kp] != null).sort((a, b) => (b[kp] as number) - (a[kp] as number));
    const pWoj = progi(woj.map((w) => w[k] as number));
    const pPow = progi(pow.map((x) => x[kp] as number));
    stan = {};
    woj.forEach((w, i) => { stan[`w${w[0]}`] = { nazwa: w[1], v: w[k] as number, miejsce: i + 1, z: woj.length }; });
    pow.forEach((x, i) => { stan[x[0]] = { nazwa: x[1], v: x[kp] as number, miejsce: i + 1, z: pow.length, wojNazwa: nazwaWoj(x[0].slice(0, 2)) }; });
    medianaTeraz = poziomPow ? m.mediana[String(r)][String(kp)] : m.mediana[`w${r}`][String(k)];

    const q = norm(szukaj.value.trim());
    sciezki.forEach((p) => {
      const t = p.dataset.t!;
      const s = poziomPow ? stan[t] : stan[`w${t.slice(0, 2)}`];
      const c = s?.v == null ? -1 : klasa(s.v, poziomPow ? pPow : pWoj);
      p.style.fill = c < 0 ? '#f3f5f8' : KOLORY[c];
      p.style.stroke = poziomPow ? '#ffffff' : p.style.fill;
      p.classList.toggle('poza', !!wojFiltr && !t.startsWith(wojFiltr));
      p.classList.toggle('trafiony', !!q && norm(stan[t]?.nazwa ?? '').includes(q));
    });
    if (skala) {
      const w = poziomPow ? pow.filter((x) => x[0].startsWith(wojFiltr!)).map((x) => x[kp] as number) : woj.map((x) => x[k] as number);
      const g = [Math.min(...(poziomPow ? pow.map((x) => x[kp] as number) : w)), ...(poziomPow ? pPow : pWoj), Math.max(...(poziomPow ? pow.map((x) => x[kp] as number) : w))];
      skala.innerHTML = KOLORY.map((c, i) => `<li><span style="background:${c}"></span>${fmt(g[i])}–${fmt(g[i + 1])}${NBSP}zł</li>`).join('');
    }
    if (poziomInfo) poziomInfo.innerHTML = wojFiltr
      ? `Województwo ${nazwaWoj(wojFiltr)}${poziomPow ? ': powiaty (przedziały liczone dla całego kraju)' : ''}. <button type="button" class="link lz-wyczysc">Cała Polska</button>`
      : 'Cała Polska: województwa. Kliknij, żeby zobaczyć powiaty.';
    zoom();

    const lista = pow.map((x, i) => ({ x, miejsce: i + 1 }))
      .filter(({ x }) => (!wojFiltr || x[0].startsWith(wojFiltr)) && (!q || norm(x[1]).includes(q)));
    const pokaz = wszystkie || q || wojFiltr ? lista : lista.slice(0, 10).concat(lista.length > 15 ? lista.slice(-5) : []);
    ranking.innerHTML = pokaz.map(({ x, miejsce }) => `<li data-t="${x[0]}"><span class="lz-r-m">${miejsce}.</span><span class="lz-r-k" style="background:${KOLORY[klasa(x[kp] as number, pPow)]}"></span><span class="lz-r-n">${x[1]}</span><strong>${fmt(x[kp] as number)}${NBSP}zł</strong></li>`).join('')
      || '<li class="lz-r-pusto">Nie znaleziono powiatu.</li>';
    ile.textContent = `${pokaz.length} z ${pow.length} powiatów.${k === 4 ? ' Dla powiatów pokazujemy wszystkie wydatki samorządów na socjal.' : ''}`;
    wiecej.hidden = wszystkie || !!q || !!wojFiltr;
    filtrInfo.hidden = !wojFiltr;
    if (wojFiltr) filtrInfo.innerHTML = `Powiaty województwa ${nazwaWoj(wojFiltr)}. <button type="button" class="link lz-wyczysc">Wszystkie powiaty</button>`;
    wojSel.value = wojFiltr ?? '';
  }

  const ustawWoj = (t: string | null) => { wojFiltr = t; rysuj(); };
  wojSel.addEventListener('change', () => ustawWoj(wojSel.value || null));
  document.addEventListener('click', (e) => { if ((e.target as HTMLElement).classList?.contains('lz-wyczysc')) ustawWoj(null); });
  wiecej.addEventListener('click', () => { wszystkie = true; rysuj(); });
  [miara, rok].forEach((s) => s.addEventListener('change', rysuj));
  szukaj.addEventListener('input', rysuj);

  if (mapa && dymek) {
    const opis = (t: string) => {
      const poziomPow = !!wojFiltr && miara.value !== '4';
      const s = poziomPow ? stan[t] : stan[`w${t.slice(0, 2)}`];
      if (!s) return null;
      const roznica = s.v != null && medianaTeraz ? Math.round((s.v / medianaTeraz - 1) * 100) : null;
      return `<strong>${poziomPow ? `${s.nazwa} <span>(${s.wojNazwa})</span>` : s.nazwa}</strong>`
        + `<b>${s.v == null ? 'brak danych' : `${fmt(s.v)}${NBSP}zł na mieszkańca`}</b>`
        + `<span>${s.miejsce}. miejsce z ${s.z}${roznica != null ? ` · ${roznica >= 0 ? '+' : '−'}${Math.abs(roznica)}% wobec mediany` : ''}</span>`;
    };
    mapa.addEventListener('mousemove', (e) => {
      const p = (e.target as Element).closest('path[data-t]') as SVGPathElement | null;
      const h = p ? opis(p.dataset.t!) : null;
      if (!h) { dymek.hidden = true; return; }
      dymek.innerHTML = h;
      dymek.hidden = false;
      const r = mapa.parentElement!.getBoundingClientRect();
      const x = e.clientX - r.left, y = e.clientY - r.top;
      dymek.style.left = `${Math.max(4, Math.min(x + 14, r.width - dymek.offsetWidth - 4))}px`;
      dymek.style.top = `${Math.max(y - dymek.offsetHeight - 12, 4)}px`;
    });
    mapa.addEventListener('mouseleave', () => { dymek.hidden = true; });
    mapa.addEventListener('click', (e) => {
      const p = (e.target as Element).closest('path[data-t]') as SVGPathElement | null;
      if (!p) return;
      const w = p.dataset.t!.slice(0, 2);
      if (wojFiltr !== w) ustawWoj(w);
    });
    ranking.addEventListener('mouseover', (e) => {
      const li = (e.target as Element).closest('li[data-t]') as HTMLElement | null;
      sciezki.forEach((p) => p.classList.toggle('wskazany', !!li && p.dataset.t === li.dataset.t));
    });
    ranking.addEventListener('mouseleave', () => sciezki.forEach((p) => p.classList.remove('wskazany')));
  }
  rysuj();
</script>

