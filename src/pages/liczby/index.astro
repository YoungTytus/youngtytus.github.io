              <g id="mapa-pow">{mapa.powiaty.map((p: any) => <path d={p.d} data-t={p.teryt} vector-effect="non-scaling-stroke" />)}</g>
              <path id="mapa-granica" d={mapa.granica} fill="none" vector-effect="non-scaling-stroke" />
            </svg>
            <div id="dymek" class="lz-dymek" role="tooltip" hidden></div>
