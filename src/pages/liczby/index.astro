---
// Podstrona „Liczby”: ile państwo wydaje na socjal. Dane wyłącznie z data/liczby/liczby.json
// (koncept: Raport_Socjal_Wydatki/Strona/Koncept podstrony Liczby.md). Wykresy rysowane przy budowaniu
// jako SVG, bez biblioteki; interakcje (licznik, kalkulator, mapa, ranking) w małym skrypcie na dole.
import Uklad from '../../layouts/Uklad.astro';
import Ikona from '../../components/Ikona.astro';
import { korzyscPoId } from '../../lib/model.mjs';
import {
  KARTY_PROGRAMOW, kodProgramu, mapaPowiatow, kratki, liczba, liczby, mediana, mld, nazwaKrotka, naMieszkanca, proc,
  sumaRok, treemap, wzrostCen, zl,
} from '../../lib/liczby.mjs';

const d = liczby();
if (!d) return Astro.redirect('/');

const ROK = 2025;
const s25 = sumaRok(d, ROK);
const s20 = sumaRok(d, 2020);
const naOs = naMieszkanca(d, ROK);
const ceny = wzrostCen(d);
const esc = (s: string) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;');
const krotko = (v: number) => v >= 1e9 ? `${liczba(v / 1e9, 1)} mld zł` : v >= 1e6 ? `${liczba(v / 1e6)} mln zł` : `${liczba(v / 1e3)} tys. zł`;

// ---------- S3: pięć lat ----------
const lata = d.suma.map((s: any) => s.rok);
const wzrostNom = (s25.transfery_mld / s20.transfery_mld - 1) * 100;
const wzrostReal = ceny ? ((s25.transfery_mld / s20.transfery_mld) / ceny.czynnik - 1) * 100 : null;
const tylkoInflacja = ceny ? s20.transfery_mld * ceny.czynnik : null;
const pelneLata = d.suma.filter((s: any) => s.razem_z_uslugami_jst_mld != null);
const zgodnosc = d.suma.filter((s: any) => s.razem_z_uslugami_jst_mld != null && s.cofog10_sektor_mld != null)
  .map((s: any) => ({ rok: s.rok, proc: (s.razem_z_uslugami_jst_mld / s.cofog10_sektor_mld) * 100 }));
const zgMin = Math.min(...zgodnosc.map((z: any) => z.proc)), zgMax = Math.max(...zgodnosc.map((z: any) => z.proc));

const KOL = { navy: '#0b1f3a', navy2: '#24497a', navy3: '#6f8db5', akcent: '#b7791f', siatka: '#dde4ec', tekst: '#4f5a6b' };
function wykresLinii() {
  const W = 760, H = 340, L = 60, R = 150, T = 20, B = 40;
  const ymax = Math.max(...d.suma.map((s: any) => Math.max(s.budzet_panstwa_mld ?? 0, s.razem_z_uslugami_jst_mld ?? 0, s.transfery_mld ?? 0))) * 1.08;
  const X = (r: number) => L + ((r - lata[0]) / (lata[lata.length - 1] - lata[0])) * (W - L - R);
  const Y = (v: number) => T + (1 - v / ymax) * (H - T - B);
  const cz: string[] = [];
  const krok = ymax > 600 ? 200 : 100;
  for (let v = 0; v <= ymax; v += krok) cz.push(`<line x1="${L}" x2="${W - R}" y1="${Y(v)}" y2="${Y(v)}" stroke="${KOL.siatka}"/><text x="${L - 8}" y="${Y(v) + 4}" text-anchor="end" font-size="12" fill="${KOL.tekst}">${v}</text>`);
  lata.forEach((r: number) => cz.push(`<text x="${X(r)}" y="${H - B + 22}" text-anchor="middle" font-size="12" fill="${KOL.tekst}">${r}</text>`));
  cz.push(`<text x="${L - 8}" y="${T - 6}" text-anchor="end" font-size="11" fill="${KOL.tekst}">mld zł</text>`);
  const linia = (pkt: [number, number][], kolor: string, przer = false, gr = 3) =>
    `<polyline points="${pkt.map(([r, v]) => `${X(r)},${Y(v)}`).join(' ')}" fill="none" stroke="${kolor}" stroke-width="${gr}" ${przer ? 'stroke-dasharray="6 6"' : ''} stroke-linejoin="round"/>`;
  const kropki = (pkt: [number, number][], kolor: string) => pkt.map(([r, v]) => `<circle cx="${X(r)}" cy="${Y(v)}" r="4.5" fill="${kolor}" stroke="#fff" stroke-width="1.5"/>`).join('');
  const bud = d.suma.filter((s: any) => s.budzet_panstwa_mld != null).map((s: any) => [s.rok, s.budzet_panstwa_mld] as [number, number]);
  const tr = d.suma.map((s: any) => [s.rok, s.transfery_mld] as [number, number]);
  const przybl = d.suma.filter((s: any) => /przybli/i.test(s.metoda)).map((s: any) => s.rok);
  const ostPrzybl = Math.max(...przybl);
  const raz = pelneLata.map((s: any) => [s.rok, s.razem_z_uslugami_jst_mld] as [number, number]);
  cz.push(linia(bud, KOL.akcent, false, 2.5), kropki(bud, KOL.akcent));
  cz.push(linia(tr.filter(([r]) => r <= ostPrzybl + 1), KOL.navy3, true), linia(tr.filter(([r]) => r > ostPrzybl), KOL.navy3), kropki(tr, KOL.navy3));
  cz.push(linia(raz, KOL.navy, false, 3.5), kropki(raz, KOL.navy));
  if (tylkoInflacja) {
    cz.push(`<line x1="${X(lata[0])}" y1="${Y(s20.transfery_mld)}" x2="${X(ROK)}" y2="${Y(tylkoInflacja)}" stroke="${KOL.tekst}" stroke-width="1.5" stroke-dasharray="2 5"/>`,
      `<circle cx="${X(ROK)}" cy="${Y(tylkoInflacja)}" r="4" fill="#fff" stroke="${KOL.tekst}" stroke-width="2"/>`);
  }
  const podpisy = [
    { y: Y(bud[bud.length - 1][1]), t: `budżet ${liczba(bud[bud.length - 1][1])}`, k: KOL.akcent },
    { y: Y(raz[raz.length - 1][1]), t: `socjal ${liczba(raz[raz.length - 1][1])}`, k: KOL.navy },
    { y: Y(tr[tr.length - 1][1]), t: `transfery ${liczba(tr[tr.length - 1][1])}`, k: KOL.navy2 },
    ...(tylkoInflacja ? [{ y: Y(tylkoInflacja), t: `z inflacją ${liczba(tylkoInflacja)}`, k: KOL.tekst }] : []),
  ].sort((a, b) => a.y - b.y);
  podpisy.forEach((p, i) => { if (i && p.y - podpisy[i - 1].y < 16) p.y = podpisy[i - 1].y + 16; });
  podpisy.forEach((p) => cz.push(`<text x="${W - R + 10}" y="${p.y + 4}" font-size="12.5" font-weight="700" fill="${p.k}">${esc(p.t)}</text>`));
  return { svg: cz.join(''), W, H, przybl };
}
const linie = wykresLinii();

// ---------- S4: kto płaci ----------
const platnicy = Object.entries(d.platnicy_2022_2025_mld) as [string, Record<string, number>][];
const lataP = Object.keys(platnicy[0][1]).map(Number).sort();
const nazwaPlatnika = (n: string) => n.replace(/^FUS: .*/, 'ZUS: emerytury, renty, zasiłki (FUS)').replace(/^FER \(KRUS\).*/, 'KRUS (FER)').replace(/^FEP: .*/, 'Emerytury pomostowe (FEP)')
  .replace(/^Fundusz Solidarnościowy.*/, 'Fundusz Solidarnościowy').replace(/^Fundusz Pracy.*/, 'Fundusz Pracy').replace(/^Budżet państwa.*/, 'Budżet państwa: świadczenia')
  .replace(/^JST: świadczenia.*/, 'Samorządy: świadczenia').replace(/^JST: usługi.*/, 'Samorządy: usługi (OPS, DPS, żłobki)');
const KOL_P = ['#0b1f3a', '#2c5282', '#4a6fa5', '#7b9bc8', '#a9bfdd', '#b7791f', '#3f6b5c', '#86b1a0'];
const krotkaPlatnika = (n: string) => nazwaPlatnika(n).replace(/^ZUS: .*/, 'ZUS').replace(/^Emerytury pomostowe.*/, 'Pomostowe (FEP)').replace(/^Budżet państwa: .*/, 'Budżet państwa')
  .replace(/^Samorządy: usługi.*/, 'Samorządy: usługi');
const platnicyKol = platnicy.map(([n, v], i) => ({ n, nazwa: nazwaPlatnika(n), krotka: krotkaPlatnika(n), v, kolor: /^Budżet/.test(n) ? KOL.akcent : KOL_P[i % KOL_P.length] }));
const sumaP = (r: number) => platnicy.reduce((a, [, v]) => a + (v[String(r)] ?? 0), 0);
const budzetP = platnicy.find(([n]) => /^Budżet/.test(n))?.[1][String(ROK)] ?? null;
const pozaBudzetem = budzetP != null ? (1 - budzetP / sumaP(ROK)) * 100 : null;
function wykresWarstw() {
  const W = 760, H = 340, L = 60, R = 210, T = 20, B = 40;
  const ymax = Math.max(...lataP.map(sumaP)) * 1.05;
  const X = (r: number) => L + ((r - lataP[0]) / (lataP[lataP.length - 1] - lataP[0])) * (W - L - R);
  const Y = (v: number) => T + (1 - v / ymax) * (H - T - B);
  const cz: string[] = [];
  for (let v = 0; v <= ymax; v += 200) cz.push(`<line x1="${L}" x2="${W - R}" y1="${Y(v)}" y2="${Y(v)}" stroke="${KOL.siatka}"/><text x="${L - 8}" y="${Y(v) + 4}" text-anchor="end" font-size="12" fill="${KOL.tekst}">${v}</text>`);
  lataP.forEach((r) => cz.push(`<text x="${X(r)}" y="${H - B + 22}" text-anchor="middle" font-size="12" fill="${KOL.tekst}">${r}</text>`));
  cz.push(`<text x="${L - 8}" y="${T - 6}" text-anchor="end" font-size="11" fill="${KOL.tekst}">mld zł</text>`);
  const dol = Object.fromEntries(lataP.map((r) => [r, 0]));
  const podpisy: any[] = [];
  platnicyKol.forEach((p) => {
    const gora = lataP.map((r) => dol[r] + (p.v[String(r)] ?? 0));
    const pts = [...lataP.map((r, i) => `${X(r)},${Y(gora[i])}`), ...[...lataP].reverse().map((r) => `${X(r)},${Y(dol[r])}`)];
    cz.push(`<polygon points="${pts.join(' ')}" fill="${p.kolor}" stroke="#fff" stroke-width="1"/>`);
    const ost = lataP[lataP.length - 1];
    podpisy.push({ y: Y((dol[ost] + gora[gora.length - 1]) / 2), t: `${p.krotka} ${liczba(p.v[String(ost)], 1)}`, k: p.kolor });
    lataP.forEach((r, i) => { dol[r] = gora[i]; });
  });
  podpisy.sort((a, b) => a.y - b.y).forEach((p, i, t) => { if (i && p.y - t[i - 1].y < 15) p.y = t[i - 1].y + 15; });
  podpisy.forEach((p) => cz.push(`<rect x="${W - R + 8}" y="${p.y - 5}" width="10" height="10" fill="${p.k}"/><text x="${W - R + 24}" y="${p.y + 4}" font-size="12" fill="#121a2a">${esc(p.t)}</text>`));
  return { svg: cz.join(''), W, H };
}
const warstwy = wykresWarstw();

// ---------- S5: na co idą pieniądze (treemap) ----------
const sumaProgramow = d.programy.reduce((a: number, p: any) => a + (p.mld[String(ROK)] ?? 0), 0);
const pozostale = s25.razem_z_uslugami_jst_mld - sumaProgramow;
const programy = d.programy.map((p: any, i: number) => ({
  ...p, i, krotka: nazwaKrotka(p.nazwa), kod: kodProgramu(p.nazwa),
  karty: (KARTY_PROGRAMOW as Record<string, string[]>)[p.nazwa]?.map((id) => korzyscPoId(id)).filter(Boolean) ?? [],
}));
const TM_W = 760, TM_H = 420;
const prostokaty = treemap([
  ...programy.filter((p: any) => (p.mld[String(ROK)] ?? 0) > 0).map((p: any) => ({ id: `program-${p.i}`, nazwa: p.krotka, wartosc: p.mld[String(ROK)] })),
  ...(pozostale > 0 ? [{ id: 'program-pozostale', nazwa: 'Pozostałe: usługi samorządów i inne świadczenia', wartosc: pozostale }] : []),
].sort((a, b) => b.wartosc - a.wartosc), TM_W, TM_H);
const TM_KOL = ['#0b1f3a', '#15345c', '#24497a', '#2c5282', '#3d6496', '#4a6fa5', '#5d80b3', '#7b9bc8'];
const lataProg = Object.keys(d.programy[0].mld).sort();

// ---------- S6: inflacja ----------
const hantle = programy.filter((p: any) => p.wzrost_nominalny_proc != null && p.wzrost_realny_proc != null)
  .sort((a: any, b: any) => b.wzrost_realny_proc - a.wzrost_realny_proc);
const hMin = Math.min(0, ...hantle.map((p: any) => p.wzrost_realny_proc)) - 10;
const hMax = Math.max(...hantle.map((p: any) => p.wzrost_nominalny_proc)) + 10;
const hX = (v: number) => ((v - hMin) / (hMax - hMin)) * 100;
const program = (re: RegExp) => programy.find((p: any) => re.test(p.nazwa));
const p13 = program(/^13\./), pMund = program(/mundur/i), p800 = program(/800/), pRodz = program(/rodzinne/i), pBezr = program(/bezrobotn/i);

// ---------- S7: budżet państwa ----------
const dzialy = [...d.dzialy_budzetu].sort((a: any, b: any) => b.udzial_2025_proc - a.udzial_2025_proc);
const SOCJALNE = new Set(['753', '855', '852']);
const pokazane = dzialy.slice(0, 6);
const resztaUdz = 100 - pokazane.reduce((a: number, x: any) => a + x.udzial_2025_proc, 0);
const kategorie = [...pokazane.map((x: any) => ({ nazwa: x.nazwa, kod: x.kod, udz: x.udzial_2025_proc, mld: x['2025_mld'] })), { nazwa: 'Pozostałe działy', kod: null, udz: resztaUdz, mld: null }];
const KOL_W = { socjal: ['#0b1f3a', '#2c5282', '#5d80b3'], inne: ['#b7791f', '#8a6d3b', '#a3a9b3', '#c9ced6', '#e1e5ea'] };
let iS = 0, iI = 0;
const katKol = kategorie.map((k: any) => ({ ...k, socjal: SOCJALNE.has(k.kod), kolor: SOCJALNE.has(k.kod) ? KOL_W.socjal[iS++ % 3] : KOL_W.inne[Math.min(iI++, 4)] }));
const ileKratek = kratki(katKol.map((k: any) => k.udz));
const waffle = katKol.flatMap((k: any, i: number) => Array.from({ length: ileKratek[i] }, () => k));
const udzSocjal = dzialy.filter((x: any) => SOCJALNE.has(x.kod)).reduce((a: number, x: any) => a + x.udzial_2025_proc, 0);
const dlug = d.dzialy_budzetu.find((x: any) => x.kod === '757');
const cofogOst = [...d.suma].reverse().find((s: any) => s.cofog10_proc_pkb != null);

// ---------- S8: mapa i ranking ----------
const latMapy = [...new Set(d.powiaty.map((p: any) => p.rok))].sort() as number[];
const rokMapy = latMapy[latMapy.length - 1];
const medianaPow = mediana(d.powiaty.filter((p: any) => p.rok === rokMapy).map((p: any) => p.jst_socjal_zl_os));
const jstRazem = (platnicy.filter(([n]) => /^JST/.test(n)).reduce((a, [, v]) => a + (v[String(ROK)] ?? 0), 0));
const daneMapy = {
  woj: d.wojewodztwa.map((w: any) => [w.teryt, w.nazwa, w.rok, w.jst_socjal_zl_os, w.jst_swiadczenia_gotowka_zl_os ?? null, w.jst_srodki_wlasne_zl_os, w.ludnosc]),
  pow: d.powiaty.map((p: any) => [p.teryt, p.nazwa, p.rok, p.jst_socjal_zl_os, null, p.jst_srodki_wlasne_zl_os, p.ludnosc]),
  // mediany do dymka: klucz rok (powiaty) albo w+rok (województwa), potem numer miary
  mediana: Object.fromEntries(latMapy.flatMap((r) => [
    [String(r), { 3: mediana(d.powiaty.filter((p: any) => p.rok === r).map((p: any) => p.jst_socjal_zl_os)), 5: mediana(d.powiaty.filter((p: any) => p.rok === r).map((p: any) => p.jst_srodki_wlasne_zl_os)) }],
    [`w${r}`, { 3: mediana(d.wojewodztwa.filter((w: any) => w.rok === r).map((w: any) => w.jst_socjal_zl_os)), 4: mediana(d.wojewodztwa.filter((w: any) => w.rok === r).map((w: any) => w.jst_swiadczenia_gotowka_zl_os)), 5: mediana(d.wojewodztwa.filter((w: any) => w.rok === r).map((w: any) => w.jst_srodki_wlasne_zl_os)) }],
  ])),
};
const wojLista = d.wojewodztwa.filter((w: any) => w.rok === rokMapy).sort((a: any, b: any) => a.nazwa.localeCompare(b.nazwa, 'pl'));
const mapa = mapaPowiatow(1000);

// ---------- S1: liczby do licznika i przełącznika ----------
const bez = d.bez_emerytur_zus_2025;
const licz = d.licznik_2025;
const daneKlienta = { naOs, bezNaOs: bez.zl_na_mieszkanca, zlNaSek: licz.zl_na_sekunde };

const opisSeo = `Ile państwo wydaje na socjal: ${mld(s25.razem_z_uslugami_jst_mld)} w ${ROK} r., ${zl(naOs)} na mieszkańca. Kto płaci, na co idą pieniądze, co wygrało z inflacją i ile wydaje Twój powiat.`;
---
<Uklad tytul="Liczby: ile państwo wydaje na socjal" opis={opisSeo.replace(/ /g, ' ')} sekcja="liczby">
  <div class="hero-outer">
    <div class="wrap">
      <section class="hero lz-hero" aria-labelledby="lz-tytul">
        <p class="eyebrow">Liczby · rok {ROK}</p>
        <h1 id="lz-tytul" class="sr-only">Ile państwo wydaje na socjal</h1>
        <p class="lz-wielka" aria-hidden="true"><span data-pelna>{liczba(s25.razem_z_uslugami_jst_mld, 1)}</span><span data-bez hidden>{liczba(bez.mld, 1)}</span> <small>mld zł</small></p>
        <p class="lz-podtytul">
          <span data-pelna>Tyle w {ROK} r. państwo wydało na socjal: emerytury, renty, zasiłki, 800+ i usługi samorządów.</span>
          <span data-bez hidden>Tyle zostaje po odjęciu emerytur i rent z ZUS. Sam ZUS dostał w {ROK} r. {mld(bez.dotacja_budzetu_do_FUS_mld)} dotacji z budżetu, bo składki nie wystarczają.</span>
        </p>
        <p class="lz-naos"><strong data-pelna>{zl(naOs)}</strong><strong data-bez hidden>{zl(bez.zl_na_mieszkanca)}</strong> na każdego mieszkańca Polski</p>
        <label class="lz-przelacznik"><input type="checkbox" id="bez-zus" /> <span>Pokaż bez emerytur i rent ZUS</span></label>
        <p class="lz-hint">Często słyszymy, że emerytury to nie socjal, bo opłacają je składki. Przełącznik pokazuje, ile zostaje bez nich.</p>
        <div class="lz-licznik" aria-describedby="lz-tempo">
          <p>Od otwarcia tej strony państwo wydało na socjal:</p>
          <p class="lz-licznik-liczba"><span id="licznik" aria-hidden="true">0</span> zł</p>
          <p id="lz-tempo" class="lz-tempo">Co sekundę {krotko(licz.zl_na_sekunde)}. Co godzinę {krotko(licz.zl_na_godzine)}. Co dzień {krotko(licz.zl_na_dzien)}.</p>
        </div>
      </section>
    </div>
  </div>

  <section class="section wrap lz-sekcja" aria-labelledby="lz-rodzina">
    <p class="kicker">Twoja rodzina</p>
    <h2 id="lz-rodzina">Ile to na Twoje gospodarstwo domowe?</h2>
    <div class="lz-kalk">
      <label for="osoby">Liczba osób w gospodarstwie</label>
      <select id="osoby">{Array.from({ length: 8 }, (_, i) => <option value={i + 1} selected={i === 3}>{i + 1}</option>)}</select>
      <p class="lz-kalk-wynik" aria-live="polite"><span id="kalk-wynik">{zl(4 * naOs)}</span> rocznie</p>
    </div>
    <p class="summary-note">Liczba osób × {zl(naOs)} (wydatki na socjal na mieszkańca w {ROK} r.). To średnia na osobę, a nie kwota, którą Twoja rodzina dostaje.</p>
  </section>

  <section class="section section-soft" aria-labelledby="lz-piec">
    <div class="wrap">
      <p class="kicker">Pięć lat</p>
      <h2 id="lz-piec">Wydatki na socjal rosną szybciej niż ceny.</h2>
      <p class="lz-lead">Same wypłaty dla ludzi (transfery) wzrosły z {mld(s20.transfery_mld)} w {lata[0]} r. do {mld(s25.transfery_mld)} w {ROK} r., czyli o {proc(wzrostNom)}.{wzrostReal != null && <> Po odjęciu wzrostu cen to nadal {proc(wzrostReal, 0, true)}. Gdyby rosły tylko razem z cenami, w {ROK} r. byłoby to {mld(tylkoInflacja!)}.</>}</p>
      <figure class="chart">
        <ul class="legend" aria-label="Legenda">
          <li><svg viewBox="0 0 26 12" aria-hidden="true"><line x1="0" x2="26" y1="6" y2="6" stroke={KOL.navy} stroke-width="3.5" /></svg>Socjal razem z usługami samorządów</li>
          <li><svg viewBox="0 0 26 12" aria-hidden="true"><line x1="0" x2="26" y1="6" y2="6" stroke={KOL.navy3} stroke-width="3" /></svg>Same transfery do ludzi</li>
          <li><svg viewBox="0 0 26 12" aria-hidden="true"><line x1="0" x2="26" y1="6" y2="6" stroke={KOL.akcent} stroke-width="2.5" /></svg>Wydatki budżetu państwa (dla skali)</li>
          {ceny && <li><svg viewBox="0 0 26 12" aria-hidden="true"><line x1="0" x2="26" y1="6" y2="6" stroke={KOL.tekst} stroke-width="1.5" stroke-dasharray="2 4" /></svg>Gdyby transfery rosły jak ceny</li>}
        </ul>
        <div class="chart-scroll" tabindex="0" role="group" aria-label="Wykres, przewiń w poziomie na małym ekranie">
          <svg viewBox={`0 0 ${linie.W} ${linie.H}`} role="img" aria-label={`Wydatki na socjal ${lata[0]}–${ROK} w mld zł; pełne dane w tabeli pod wykresem.`} set:html={linie.svg} />
        </div>
        <figcaption>Linia przerywana ({linie.przybl.join(' i ')}): przybliżenie, bo dla tych lat nie ma sprawozdań samorządów; zamiast ich wydatków liczymy dotacje z budżetu. Budżet państwa pokazujemy dla skali, nie jako udział: ponad połowa socjalu płynie poza budżetem.</figcaption>
      </figure>
      <details class="lz-tabela">
        <summary>Pokaż tabelę</summary>
        <div class="table-wrap" tabindex="0"><table>
          <thead><tr><th scope="col">Rok</th><th scope="col">Transfery</th><th scope="col">Razem z usługami samorządów</th><th scope="col">Budżet państwa</th><th scope="col">Ochrona socjalna wg MF (COFOG 10)</th><th scope="col">Metoda</th></tr></thead>
          <tbody>{d.suma.map((s: any) => <tr><th scope="row">{s.rok}</th><td>{mld(s.transfery_mld, 2)}</td><td>{s.razem_z_uslugami_jst_mld != null ? mld(s.razem_z_uslugami_jst_mld, 2) : '—'}</td><td>{mld(s.budzet_panstwa_mld, 2)}</td><td>{s.cofog10_sektor_mld != null ? `${mld(s.cofog10_sektor_mld)} (${liczba(s.cofog10_proc_pkb, 1)}% PKB)` : '—'}</td><td>{s.metoda}</td></tr>)}</tbody>
        </table></div>
        {ceny && <p class="summary-note">Wzrost cen {lata[0]}–{ROK}: ×{liczba(ceny.czynnik, 3)}, odczytany z danych o wzroście nominalnym i realnym programów (GUS CPI). Plik nie podaje inflacji rok po roku, dlatego nie rysujemy całej linii w cenach stałych.</p>}
      </details>
    </div>
  </section>

  <section class="section wrap lz-sekcja" aria-labelledby="lz-kto">
    <p class="kicker">Kto płaci</p>
    <h2 id="lz-kto">{pozaBudzetem != null ? `${liczba(pozaBudzetem)}% socjalu płynie poza budżetem państwa.` : 'Kto wypłaca pieniądze.'}</h2>
    <p class="lz-lead">Największym płatnikiem jest ZUS. Budżet państwa wypłaca bezpośrednio {budzetP != null && mld(budzetP)} z {mld(sumaP(ROK))}. Dotacji, które budżet przekazuje do ZUS i samorządów, nie liczymy drugi raz.</p>
    <figure class="chart">
      <div class="chart-scroll" tabindex="0" role="group" aria-label="Wykres, przewiń w poziomie na małym ekranie">
        <svg viewBox={`0 0 ${warstwy.W} ${warstwy.H}`} role="img" aria-label={`Wydatki na socjal według płatnika ${lataP[0]}–${lataP[lataP.length - 1]}; dane w tabeli pod wykresem.`} set:html={warstwy.svg} />
      </div>
      <figcaption>Warstwy sumują się do całych wydatków na socjal w danym roku (mld zł).</figcaption>
    </figure>
    <details class="lz-tabela">
      <summary>Pokaż tabelę</summary>
      <div class="table-wrap" tabindex="0"><table>
        <thead><tr><th scope="col">Płatnik</th>{lataP.map((r) => <th scope="col">{r}</th>)}</tr></thead>
        <tbody>
          {platnicyKol.map((p) => <tr><th scope="row"><span class="lz-kwadrat" style={`background:${p.kolor}`} aria-hidden="true"></span>{p.nazwa}</th>{lataP.map((r) => <td>{liczba(p.v[String(r)], 2)}</td>)}</tr>)}
          <tr class="lz-suma"><th scope="row">Razem</th>{lataP.map((r) => <td>{liczba(sumaP(r), 2)}</td>)}</tr>
