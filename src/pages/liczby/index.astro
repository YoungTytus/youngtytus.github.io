      <div class="lz-h-leg" aria-hidden="true"><span><i class="lz-k lz-k-nom"></i>wzrost nominalny</span><span><i class="lz-k lz-k-real"></i>po uwzględnieniu cen</span></div>
      <div role="row" class="sr-only"><span role="columnheader">Program</span><span role="columnheader">Nominalnie</span><span role="columnheader">Realnie</span></div>
      {hantle.map((p: any) => {
        const a = hX(Math.min(p.wzrost_realny_proc, p.wzrost_nominalny_proc)), b = hX(Math.max(p.wzrost_realny_proc, p.wzrost_nominalny_proc));
        return (
          <div class="lz-h-wiersz" role="row">
            <span class="lz-h-nazwa" role="rowheader"><a class="link" href={`#program-${p.i}`}>{p.krotka}</a></span>
            <span class="lz-h-tor" aria-hidden="true">
              <span class="lz-h-zero" style={`left:${hX(0)}%`}></span>
              <span class="lz-h-linia" style={`left:${a}%;width:${b - a}%`}></span>
              <span class="lz-k lz-k-nom" style={`left:${hX(p.wzrost_nominalny_proc)}%`}></span>
              <span class:list={['lz-k lz-k-real', { ujemny: p.wzrost_realny_proc < 0 }]} style={`left:${hX(p.wzrost_realny_proc)}%`}></span>
            </span>
            <span class="lz-h-liczby"><span role="cell">{proc(p.wzrost_nominalny_proc, 0, true)}</span> <span role="cell"><strong>{proc(p.wzrost_realny_proc, 0, true)}</strong></span></span>
          </div>
        );
      })}
    </div>
    <p class="summary-note">Pokazujemy programy, które istniały przez cały okres {lataProg[0]}–{ROK}. Pionowa kreska to zero. Wzrost „po uwzględnieniu cen” jest liczony średnioroczną inflacją GUS.</p>

    <aside class="lz-sledztwo" aria-labelledby="lz-fs">
      <p class="kicker">Z bliska</p>
      <h3 id="lz-fs">Fundusz Solidarnościowy: dodatkowe emerytury na kredyt</h3>
