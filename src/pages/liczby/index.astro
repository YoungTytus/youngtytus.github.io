            <div class="lz-program">
              <div class="table-wrap" tabindex="0"><table>
                <thead><tr>{lataProg.map((r) => <th scope="col">{r}</th>)}</tr></thead>
                <tbody><tr>{lataProg.map((r) => <td>{p.mld[r] ? liczba(p.mld[r], 2) : '—'}</td>)}</tr></tbody>
              </table></div>
              <p>{p.wzrost_nominalny_proc != null ? <>Od {lataProg[0]} do {ROK} r.: <strong>{proc(p.wzrost_nominalny_proc, 0, true)}</strong> nominalnie, <strong>{proc(p.wzrost_realny_proc, 0, true)}</strong> po uwzględnieniu cen.</> : <>Program nie istniał przez cały okres {lataProg[0]}–{ROK}, więc nie liczymy wzrostu.</>}</p>
              {p.karty.length > 0 && <p>Karty świadczeń: {p.karty.map((k: any, i: number) => <>{i > 0 && ', '}<a class="link" href={`/korzysc/${k.id}/`}>{k.nazwa}</a></>)}</p>}
            </div>
