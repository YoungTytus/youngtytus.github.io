                <thead><tr><th scope="col">Powiat</th><th scope="col">Miejsce</th><th scope="col">zł na mieszkańca</th></tr></thead>
                <tbody>
                  {nr === '8b' && <tr class="lz-odn"><th scope="row">mediana kraju</th><td>-</td><td>{liczba(medianaPow)}</td></tr>}
                  {lista.map((p: any, i: number) => <tr><th scope="row">{p.nazwa} <span class="lz-woj">({nazwaWoj(p.teryt.slice(0, 2))})</span></th><td>{start + i + 1}</td><td>{liczba(p.jst_socjal_zl_os)}</td></tr>)}
                  {nr === '8a' && <tr class="lz-odn"><th scope="row">mediana kraju</th><td>-</td><td>{liczba(medianaPow)}</td></tr>}
                </tbody>
              </table></div>
              <p class="lz-zrodlo">{tp(`Źródło: ${ZR.rb} ${rokMapy}; GUS, ludność 31.12.${rokMapy}.`)}</p>
            </figure>
          ))}
        </div>
        <script type="application/json" id="dane-mapy" set:html={JSON.stringify(daneMapy)} />
      </section>

      <section id="fs" class="detail-section lz-sek" aria-labelledby="h-fs">
        <p class="kicker">Z bliska</p>
        <h2 id="h-fs">{tp('13. i 14. emerytura a długi Funduszu Solidarnościowego')}</h2>
        <p class="lz-akapit">{tp(fs.opis)}</p>
        <figure class="lz-obiekt">
          <figcaption class="lz-tytul">{tp('Tabela 9. Kto wypłacał 13. i 14. emeryturę i jak finansował się fundusz')}</figcaption>
          <div class="table-wrap lz-tabela" tabindex="0"><table>
            <thead><tr><th scope="col">Rok</th><th scope="col">Kto wypłacał</th><th scope="col">{tp('13. i 14. emerytura, mld zł')}</th><th scope="col">Pożyczki i stan funduszu</th></tr></thead>
            <tbody>{lataProg.map((r) => <tr><th scope="row">{r}</th><td class="tekst">{kto(Number(r))}</td><td>{liczba(p1314?.mld[r], 2)}</td><td class="tekst">{zdarzenia(Number(r)).length ? zdarzenia(Number(r)).map((z) => <div>{tp(z)}</div>) : '-'}</td></tr>)}</tbody>
          </table></div>
          <p class="lz-zrodlo">{tp(`Źródło: ${ZR.mf} ${lataProg[0]}-${ROK} (Omówienie, tab. 040), strony podane w tabeli.`)}</p>
        </figure>
      </section>

      <section id="dane" class="detail-section lz-sek" aria-labelledby="h-dane">
        <p class="kicker">O danych</p>
        <h2 id="h-dane">Jak liczymy i czego nie ma w sumie</h2>
        <dl class="lz-definicje">
          <div><dt>M1</dt><dd>{tp('Transfery pieniężne do ludzi: emerytury, renty, zasiłki, 800+ i inne świadczenia w gotówce, liczone u płatnika.')}</dd></div>
          <div><dt>M2</dt><dd>{tp('M1 oraz usługi samorządów: ośrodki i domy pomocy społecznej, piecza zastępcza, żłobki.')}</dd></div>
          <div><dt>COFOG 10</dt><dd>{tp('Wydatki na ochronę socjalną całego sektora publicznego według klasyfikacji funkcji rządu (MF, ESA 2010). Niezależna liczba do porównania.')}</dd></div>
          <div><dt>§ 3110</dt><dd>{tp('Paragraf klasyfikacji budżetowej „świadczenia społeczne”: wypłaty w gotówce dla osób.')}</dd></div>
          <div><dt>JST</dt><dd>{tp('Jednostki samorządu terytorialnego: gminy, powiaty, województwa.')}</dd></div>
          <div><dt>FUS</dt><dd>{tp('Fundusz Ubezpieczeń Społecznych, z którego ZUS wypłaca emerytury, renty i zasiłki.')}</dd></div>
          <div><dt>FER</dt><dd>{tp('Fundusz Emerytalno-Rentowy KRUS (rolnicy).')}</dd></div>
          <div><dt>FS</dt><dd>{tp('Fundusz Solidarnościowy, m.in. 13. i 14. emerytura w latach 2020-2023.')}</dd></div>
          <div><dt>Ceny stałe</dt><dd>{tp(`Kwoty przeliczone średniorocznym CPI GUS na ceny ${ROK}.`)}</dd></div>
        </dl>
        <div class="lz-dwie lz-rowne">
          <div>
            <h3>Jak liczymy</h3>
            <ol class="lz-punkty">
              <li>{tp('Liczymy wypłaty u faktycznego płatnika: ZUS, KRUS, fundusze, budżet państwa, samorządy.')}</li>
              <li>{tp('Dotacji przekazywanych między nimi nie liczymy drugi raz.')}</li>
              <li>{tp('Źródła: sprawozdania MF z wykonania budżetu, sprawozdania samorządów, ludność i inflacja z GUS.')}</li>
              <li>{tp('Wynik porównujemy z liczbą MF dla ochrony socjalnej (COFOG 10).')}</li>
              <li>{tp('Suma jest dolną granicą: nie obejmuje NFZ, funduszy BGK ani ulg podatkowych.')}</li>
            </ol>
            <h3>Zastrzeżenia</h3>
            <ul class="lz-punkty">
              {d.meta.zastrzezenia.map((z: string) => <li>{tp(z)}</li>)}
              <li>{tp('Brak porównania z innymi krajami UE (Eurostat); planujemy je w kolejnej wersji.')}</li>
            </ul>
          </div>
          <div>
            <h3>Źródła</h3>
            <ul class="lz-punkty">{d.meta.zrodla.map((z: string) => <li>{tp(z)}</li>)}</ul>
            <h3>Pobierz dane</h3>
            <p class="lz-pobierz"><a class="btn btn-sm" href="/dane/liczby.json" download="liczby.json">liczby.json</a> <a class="btn btn-sm" href="/dane/liczby-programy.csv" download>Programy (CSV)</a> <a class="btn btn-sm" href="/dane/liczby-powiaty.csv" download>Powiaty (CSV)</a></p>
            <p class="lz-zrodlo">Wersja danych {d.meta.wersja}, wygenerowano {d.meta.wygenerowano}. SHA-256: <code class="lz-sha">{d._sha256}</code></p>
          </div>
        </div>
      </section>
  </div>
</div>
</Uklad>

<script>
  const NBSP = ' ';
  const fmt = (v: number) => { const s = Math.round(v).toString(); return s.length > 4 ? s.replace(/\B(?=(\d{3})+(?!\d))/g, NBSP) : s; };

  // spis treści: bieżąca sekcja wyróżniona (aria-current)
  const linkiSpisu = [...document.querySelectorAll<HTMLAnchorElement>('.lz-spis a')];
  const sekcje = [...document.querySelectorAll<HTMLElement>('.lz-sek')];
  let ramka = 0;
  const zaznacz = () => {
    ramka = 0;
    const linia = innerHeight * 0.3;
    const biezaca = sekcje.filter((x) => x.getBoundingClientRect().top <= linia).pop() ?? sekcje[0];
    linkiSpisu.forEach((a) => a.setAttribute('aria-current', String(a.hash === `#${biezaca.id}`)));
  };
  addEventListener('scroll', () => { if (!ramka) ramka = requestAnimationFrame(zaznacz); }, { passive: true });
  zaznacz();

  // przełącznik z emeryturami ZUS / bez (karty 1 i 2)
  const kpi = JSON.parse(document.getElementById('kpi')!.textContent!);
  const przyciski = [...document.querySelectorAll<HTMLButtonElement>('.lz-segment button')];
  przyciski.forEach((b) => b.addEventListener('click', () => {
    przyciski.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    const w = kpi[b.dataset.wariant!];
    document.querySelectorAll<HTMLElement>('[data-kpi]').forEach((e) => { e.textContent = w[Number(e.dataset.kpi)]; });
  }));

  // licznik (jedna linia, bez ciasteczek)
  const licznik = document.getElementById('licznik');
  if (licznik) {
    const tempo = Number(licznik.dataset.tempo);
    const start = performance.now();
    setInterval(() => { licznik.textContent = fmt(((performance.now() - start) / 1000) * tempo); }, 1000);
  }

  // sortowanie Tabeli 7
  document.querySelectorAll<HTMLTableElement>('table[data-sortowalna]').forEach((t) => {
    const th = [...t.tHead!.rows[0].cells];
    th.forEach((h, i) => h.querySelector('button')?.addEventListener('click', () => {
      const malejaco = h.getAttribute('aria-sort') !== 'descending';
      th.forEach((x) => x.removeAttribute('aria-sort'));
      h.setAttribute('aria-sort', malejaco ? 'descending' : 'ascending');
      const tekst = h.dataset.typ === 'tekst';
      const rows = [...t.tBodies[0].rows].sort((a, b) => {
        const va = a.cells[i].dataset.v!, vb = b.cells[i].dataset.v!;
        const c = tekst ? va.localeCompare(vb, 'pl') : Number(va) - Number(vb);
        return malejaco ? -c : c;
      });
      rows.forEach((r) => t.tBodies[0].appendChild(r));
    }));
  });

  // mapa powiatów (granice PRG): poziom województw albo powiatów wybranego województwa
  type Wiersz = [string, string, number, number | null, number | null, number | null, number];
  const m = JSON.parse(document.getElementById('dane-mapy')!.textContent!) as { woj: Wiersz[]; pow: Wiersz[]; mediana: Record<string, Record<string, number>> };
  const miara = document.getElementById('mapa-miara') as HTMLSelectElement;
  const rok = document.getElementById('mapa-rok') as HTMLSelectElement;
  const wojSel = document.getElementById('mapa-woj') as HTMLSelectElement;
  const szukaj = document.getElementById('szukaj-powiat') as HTMLInputElement;
  const wynikSz = document.getElementById('szukaj-wynik')!;
  const skala = document.getElementById('skala');
  const listaPow = document.getElementById('lista-pow');
  const mapa = document.getElementById('mapa-svg') as SVGSVGElement | null;
  const poziomInfo = document.getElementById('mapa-poziom');
  const dymek = document.getElementById('dymek');
  const sciezki = mapa ? [...mapa.querySelectorAll<SVGPathElement>('#mapa-pow path')] : [];
  const KOLORY = ['#e4ebf4', '#b9cbe2', '#7f9fc7', '#3d6496', '#0b1f3a'];
  const MIARY: Record<string, string> = { 3: 'Wydatki samorządów na socjal', 4: 'Świadczenia samorządów w gotówce', 5: 'Wydatki samorządów na socjal z własnych pieniędzy' };
  let wojFiltr: string | null = null;
  let stan: Record<string, { nazwa: string; v: number | null; miejsce: number; z: number; wojNazwa?: string }> = {};
  let medianaTeraz = 0;
  const norm = (s: string) => s.toLocaleLowerCase('pl').replace(/ł/g, 'l').normalize('NFD').replace(/[̀-ͯ]/g, '');
  const progi = (w: number[]) => { const s = [...w].sort((a, b) => a - b); return [1, 2, 3, 4].map((i) => s[Math.floor((i * s.length) / 5)]); };
  const klasa = (v: number, p: number[]) => p.filter((x) => v >= x).length;
  const nazwaWoj = (t: string) => m.woj.find((w) => w[0] === t)?.[1] ?? t;

  function zoom() {
    if (!mapa) return;
    if (!wojFiltr) { mapa.setAttribute('viewBox', mapa.dataset.pelny!); return; }
    const b = sciezki.filter((p) => p.dataset.t!.startsWith(wojFiltr!)).map((p) => p.getBBox());
    const x0 = Math.min(...b.map((r) => r.x)), y0 = Math.min(...b.map((r) => r.y));
    const x1 = Math.max(...b.map((r) => r.x + r.width)), y1 = Math.max(...b.map((r) => r.y + r.height));
    const pad = Math.max(x1 - x0, y1 - y0) * 0.06;
    mapa.setAttribute('viewBox', `${x0 - pad} ${y0 - pad} ${x1 - x0 + 2 * pad} ${y1 - y0 + 2 * pad}`);
  }

  function rysuj() {
    const k = Number(miara.value), r = Number(rok.value);
    const kp = k === 4 ? 3 : k; // „gotówka” jest tylko dla województw
    const poziomPow = !!wojFiltr && k !== 4;
    const woj = m.woj.filter((w) => w[2] === r && w[k] != null).sort((a, b) => (b[k] as number) - (a[k] as number));
    const pow = m.pow.filter((x) => x[2] === r && x[kp] != null).sort((a, b) => (b[kp] as number) - (a[kp] as number));
    const pWoj = progi(woj.map((w) => w[k] as number));
    const pPow = progi(pow.map((x) => x[kp] as number));
    stan = {};
    woj.forEach((w, i) => { stan[`w${w[0]}`] = { nazwa: w[1], v: w[k] as number, miejsce: i + 1, z: woj.length }; });
    pow.forEach((x, i) => { stan[x[0]] = { nazwa: x[1], v: x[kp] as number, miejsce: i + 1, z: pow.length, wojNazwa: nazwaWoj(x[0].slice(0, 2)) }; });
    medianaTeraz = poziomPow ? m.mediana[String(r)][String(kp)] : m.mediana[`w${r}`][String(k)];

    const q = norm(szukaj.value.trim());
    const trafione = q ? pow.filter((x) => norm(x[1]).includes(q)) : [];
    sciezki.forEach((p) => {
      const t = p.dataset.t!;
      const s = poziomPow ? stan[t] : stan[`w${t.slice(0, 2)}`];
      const c = s?.v == null ? -1 : klasa(s.v, poziomPow ? pPow : pWoj);
      const poza = !!wojFiltr && !t.startsWith(wojFiltr);
      p.style.fill = poza ? '#eef1f5' : c < 0 ? '#f3f5f8' : KOLORY[c];
      p.style.stroke = poziomPow && !poza ? '#ffffff' : p.style.fill;
      p.classList.toggle('trafiony', trafione.some((x) => x[0] === t));
    });
    if (skala) {
      const w = poziomPow ? pow.map((x) => x[kp] as number) : woj.map((x) => x[k] as number);
      const g = [Math.min(...w), ...(poziomPow ? pPow : pWoj), Math.max(...w)];
      skala.innerHTML = KOLORY.map((c, i) => `<li><span style="background:${c}"></span>${fmt(g[i])}-${fmt(g[i + 1])}${NBSP}zł</li>`).join('');
    }
    if (poziomInfo) poziomInfo.innerHTML = wojFiltr
      ? `Województwo ${nazwaWoj(wojFiltr)}${poziomPow ? ': powiaty (przedziały liczone dla całego kraju)' : ''}. <button type="button" class="link lz-wyczysc">Cała Polska</button>`
      : 'Cała Polska: województwa. Kliknij, żeby zobaczyć powiaty.';
    zoom();

    // wynik wyszukiwania w jednym zdaniu
    if (!q) wynikSz.textContent = '';
    else if (!trafione.length) wynikSz.textContent = 'Nie znaleziono powiatu.';
    else wynikSz.innerHTML = trafione.slice(0, 3).map((x) => {
      const s = stan[x[0]];
      return `<strong>${s.nazwa}</strong> (${s.wojNazwa}): ${fmt(s.v!)}${NBSP}zł na mieszkańca, ${s.miejsce}. miejsce na ${s.z}, mediana kraju ${fmt(m.mediana[String(r)][String(kp)])}${NBSP}zł.`;
    }).join('<br>') + (trafione.length > 3 ? ` <span>(i ${trafione.length - 3} innych)</span>` : '');

    // lista powiatów wybranego województwa
    if (listaPow) {
      listaPow.hidden = !wojFiltr;
      if (wojFiltr) listaPow.innerHTML = pow.map((x, i) => ({ x, i })).filter(({ x }) => x[0].startsWith(wojFiltr!))
        .map(({ x, i }) => `<li data-t="${x[0]}"><span>${i + 1}.</span><span>${x[1]}</span><strong>${fmt(x[kp] as number)}${NBSP}zł</strong></li>`).join('');
    }
    wojSel.value = wojFiltr ?? '';
    const tytul = document.getElementById('mapa-tytul');
    if (tytul) tytul.textContent = `Mapa 1. ${MIARY[String(k)]}, zł na mieszkańca, ${r}`;
  }

  const ustawWoj = (t: string | null) => { wojFiltr = t; rysuj(); };
  wojSel.addEventListener('change', () => ustawWoj(wojSel.value || null));
  document.addEventListener('click', (e) => { if ((e.target as HTMLElement).classList?.contains('lz-wyczysc')) ustawWoj(null); });
  [miara, rok].forEach((s) => s.addEventListener('change', rysuj));
  szukaj.addEventListener('input', rysuj);

  if (mapa && dymek) {
    const opis = (t: string) => {
      const poziomPow = !!wojFiltr && miara.value !== '4';
      if (wojFiltr && !t.startsWith(wojFiltr)) return null;
      const s = poziomPow ? stan[t] : stan[`w${t.slice(0, 2)}`];
      if (!s) return null;
      const roznica = s.v != null && medianaTeraz ? Math.round((s.v / medianaTeraz - 1) * 100) : null;
      return `<strong>${poziomPow ? `${s.nazwa} <span>(${s.wojNazwa})</span>` : s.nazwa}</strong>`
        + `<b>${s.v == null ? 'brak danych' : `${fmt(s.v)}${NBSP}zł na mieszkańca`}</b>`
        + `<span>${s.miejsce}. miejsce na ${s.z}${roznica != null ? `, ${roznica >= 0 ? '+' : '-'}${Math.abs(roznica)}${NBSP}% wobec mediany` : ''}</span>`;
    };
    const pokaz = (e: MouseEvent) => {
      const p = (e.target as Element).closest('path[data-t]') as SVGPathElement | null;
      const h = p ? opis(p.dataset.t!) : null;
      if (!h) { dymek.hidden = true; return; }
      dymek.innerHTML = h;
      dymek.hidden = false;
      const r = mapa.parentElement!.getBoundingClientRect();
      const x = e.clientX - r.left, y = e.clientY - r.top;
      dymek.style.left = `${Math.max(4, Math.min(x + 14, r.width - dymek.offsetWidth - 4))}px`;
      dymek.style.top = `${Math.max(y - dymek.offsetHeight - 12, 4)}px`;
    };
    mapa.addEventListener('mousemove', pokaz);
    mapa.addEventListener('mouseleave', () => { dymek.hidden = true; });
    mapa.addEventListener('click', (e) => {
      const p = (e.target as Element).closest('path[data-t]') as SVGPathElement | null;
      if (!p) return;
      const w = p.dataset.t!.slice(0, 2);
      if (wojFiltr !== w) ustawWoj(w);
      else pokaz(e); // ekran dotykowy: dotknięcie powiatu pokazuje dymek
    });
    listaPow?.addEventListener('mouseover', (e) => {
      const li = (e.target as Element).closest('li[data-t]') as HTMLElement | null;
      sciezki.forEach((p) => p.classList.toggle('wskazany', !!li && p.dataset.t === li.dataset.t));
    });
    listaPow?.addEventListener('mouseleave', () => sciezki.forEach((p) => p.classList.remove('wskazany')));
  }
  rysuj();
</script>

<style is:global>
  /* podstrona /liczby/: korzysta z elementów witryny (page-head, detail-layout, amount-panel, karty, tabele, .chart);
     tu tylko to, czego witryna nie ma. Globalne, bo część elementów wstawia skrypt; przedrostek lz- */
  .lz-stan { margin-top: 14px; }
  .lz-start { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 22px; padding-top: 36px; align-items: stretch; }
  .lz-glowna { margin: 0; display: flex; flex-direction: column; justify-content: center; }
  .lz-glowna .eyebrow { margin-bottom: 14px; }
  .lz-glowna-liczba { font: 600 clamp(2.6rem, 5vw, 3.6rem)/1.05 var(--serif); font-variant-numeric: tabular-nums; }
  .lz-glowna-os { margin-top: 10px; color: #d3deeb; font-size: var(--fs-base); }
  .lz-glowna-os strong { font: 600 var(--fs-lg) var(--serif); color: #fff; margin-right: 4px; }
  .lz-segment { display: inline-flex; flex-wrap: wrap; gap: 4px; margin-top: 22px; padding: 4px; border: 1px solid rgba(157, 180, 214, .45); border-radius: 999px; align-self: flex-start; }
  .lz-segment button { border: 0; background: none; color: #d3deeb; font: 600 var(--fs-sm) var(--sans); padding: 8px 16px; min-height: 40px; border-radius: 999px; cursor: pointer; transition: background-color .18s, color .18s; }
  .lz-segment button:hover { color: #fff; }
  .lz-segment button[aria-pressed='true'] { background: #fff; color: var(--navy-800); }
  .lz-statystyki { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; }
  .lz-stat { background: var(--surface); border-radius: var(--radius); box-shadow: var(--shadow-card); padding: 24px; display: flex; flex-direction: column; gap: 8px; }
  .lz-stat strong { font: 600 var(--fs-xl)/1.1 var(--serif); color: var(--navy-800); font-variant-numeric: tabular-nums; margin-top: auto; }
  .lz-stat > span:last-child { font-size: var(--fs-sm); color: var(--muted); line-height: 1.45; }
  .lz-stat #licznik { font-variant-numeric: tabular-nums; }

  .lz-spis a[aria-current='true'] { color: var(--navy-800); font-weight: 700; border-left-color: var(--red); }
  .lz-sek { scroll-margin-top: 100px; }
  .lz-sek > h2 { max-width: 820px; }
  .lz-wnioski { max-width: 820px; }
  .lz-wnioski .principle h3 { color: var(--navy-800); font-size: var(--fs-md); }
  .lz-wnioski .principle p { margin-top: 6px; }
  .lz-ramka { max-width: 820px; margin-top: 8px; background: var(--soft); border-radius: var(--radius-sm); padding: 16px 20px; font-size: var(--fs-sm); color: var(--ink-2); line-height: 1.6; }
  .lz-akapit { max-width: 760px; color: var(--ink-2); line-height: 1.7; }

  .lz-obiekt { margin: 30px 0 0; min-width: 0; }
  .lz-tytul { font-weight: 700; color: var(--navy-800); font-size: var(--fs-base); margin-bottom: 4px; }
  .lz-podtytul { font-size: var(--fs-sm); color: var(--muted); margin-bottom: 4px; }
  .lz-zrodlo { font-size: var(--fs-xs); color: var(--muted); margin-top: 10px; line-height: 1.5; max-width: 900px; }
  .lz-przewin, .lz-slupki, .lz-mapa-plotno { background: #fbfcfe; border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 16px; margin-top: 12px; }
  .lz-przewin svg { width: 100%; min-width: 560px; height: auto; display: block; }
  .lz-legenda { display: flex; flex-wrap: wrap; gap: 6px 18px; list-style: none; margin: 10px 0 0; padding: 0; font-size: var(--fs-sm); color: var(--ink-2); }
