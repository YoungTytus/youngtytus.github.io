      {pMund && <>Emerytury mundurowe: {proc(pMund.wzrost_realny_proc, 0, true)}. </>}
      {p800 && <>800+: tylko {proc(p800.wzrost_realny_proc, 0, true)}. </>}
      {pRodz && <>Świadczenia rodzinne: {proc(pRodz.wzrost_realny_proc, 0, true)}. </>}
