  <section class="section section-soft" aria-labelledby="lz-naco">
    <div class="wrap">
      <p class="kicker">Na co idą pieniądze</p>
      <h2 id="lz-naco">Ponad połowa to emerytury i renty z ZUS.</h2>
      <p class="lz-lead">Wielkość prostokąta to wydatki w {ROK} r. Kliknij program, żeby zobaczyć, jak zmieniał się od {lataProg[0]} r., i przejść do jego karty.</p>
      <figure class="chart lz-treemap">
        <svg viewBox={`0 0 ${TM_W} ${TM_H}`} role="img" aria-label={`Podział wydatków na socjal w ${ROK} r.; lista programów z kwotami pod wykresem.`}>
          {prostokaty.map((p: any, i: number) => {
            const duzy = p.w > 110 && p.h > 46;
            return (
              <a href={`#${p.id}`} aria-label={`${p.nazwa}: ${mld(p.wartosc)}`}>
                <rect x={p.x} y={p.y} width={p.w} height={p.h} fill={TM_KOL[Math.min(i, TM_KOL.length - 1)]} stroke="#fff" stroke-width="2" />
                {duzy && <text x={p.x + 10} y={p.y + 22} font-size="13" font-weight="700" fill="#fff">{p.nazwa.length > p.w / 7.5 ? `${p.nazwa.slice(0, Math.floor(p.w / 7.5) - 1)}…` : p.nazwa}</text>}
                {duzy && <text x={p.x + 10} y={p.y + 40} font-size="12.5" fill="#dbe5f3">{mld(p.wartosc)} · {liczba((p.wartosc / s25.razem_z_uslugami_jst_mld) * 100)}%</text>}
              </a>
            );
          })}
        </svg>
        <figcaption>Razem {mld(s25.razem_z_uslugami_jst_mld)}. „Pozostałe” to różnica między sumą a wymienionymi programami ({mld(pozostale)}).</figcaption>
      </figure>
      <ol class="lz-programy">
        {[...programy].sort((a: any, b: any) => (b.mld[String(ROK)] ?? 0) - (a.mld[String(ROK)] ?? 0)).map((p: any) => (
          <li><details id={`program-${p.i}`}>
