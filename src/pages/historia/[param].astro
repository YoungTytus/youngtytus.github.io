---
import Uklad from '../../layouts/Uklad.astro';
import Ikona from '../../components/Ikona.astro';
import { socjal } from '../../lib/socjal.mjs';
import { dataPL, typo } from '../../lib/format.mjs';
import { nazwaParametru, opisJednostki, ostatni, typWpisu, wartosc } from '../../lib/historia.mjs';
export function getStaticPaths() {
  return Object.entries(socjal()?.historia ?? {}).map(([param, records]) => ({ params: { param }, props: { records } }));
}
const records: any[] = [...Astro.props.records].sort((a, b) => String(b.od).localeCompare(String(a.od)));
const param = Astro.params.param!;
const nazwa = nazwaParametru(param);
const o = ostatni(records);
const jedn = o ? opisJednostki(o.jednostka) : '';
---
<Uklad tytul={`Historia: ${nazwa}`} opis={`Historia kwot: ${nazwa}. Wartości z datami i przepisami.`}>
  <div class="page-head">
    <div class="wrap">
      <nav class="breadcrumb" aria-label="Ścieżka nawigacji"><a href="/">Strona główna</a><span aria-hidden="true">/</span><a href="/historia/">Historia kwot</a><span aria-hidden="true">/</span><span aria-current="page">{nazwa}</span></nav>
      <h1>{nazwa}</h1>
      <p class="lead">{records.length} {records.length === 1 ? 'wpis' : records.length < 5 ? 'wpisy' : 'wpisów'} z przepisem i cytatem, od najnowszego. Kwoty wyliczone z parametrów są oznaczone w kolumnie „Rodzaj”.</p>
    </div>
  </div>
  <div class="wrap section">
    {o && (
      <div class="amount-panel historia-panel">
        <p class="eyebrow">Ostatni wpis</p>
        <p class="historia-kwota">{wartosc(o)}</p>
        <p class="amount-date">{jedn && `${jedn} · `}{o.od ? `od ${dataPL(o.od)}` : 'data nieustalona'}{o.do && ` do ${dataPL(o.do)}`}</p>
      </div>
    )}
    <div class="table-wrap" tabindex="0">
      <table>
        <caption>Wszystkie wpisy{jedn && ` (${jedn})`}</caption>
        <thead><tr><th scope="col">Od</th><th scope="col">Do</th><th scope="col" class="liczba">Wartość</th><th scope="col">Rodzaj</th><th scope="col">Źródło</th></tr></thead>
        <tbody>
          {records.map((r: any) => (
            <tr>
              <td>{dataPL(r.od) ?? 'nie ustalono'}</td>
              <td>{r.do ? dataPL(r.do) : <span class="muted">bez daty końca</span>}</td>
              <td class="liczba"><strong>{wartosc(r)}</strong></td>
              <td>{typWpisu(r.typ, r.wyliczona)}</td>
              <td>
                <a class="link" href={r.dowod.url} target="_blank" rel="noopener">{r.dowod.eli}, {typo(r.dowod.przepis)}<Ikona n="zewn" /><span class="sr-only"> (otwiera się w nowej karcie)</span></a>
                {r.dowod.cytat && <details><summary>Cytat</summary><blockquote lang="pl">{typo(r.dowod.cytat)}</blockquote></details>}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="summary-note"><a class="text-link" href="/historia/">Wszystkie zestawienia <Ikona n="strzalka" /></a></p>
  </div>
</Uklad>

<style>
  .historia-panel { max-width: 520px; }
  .historia-kwota { font: 700 var(--fs-3xl)/1.1 var(--num); letter-spacing: -.02em; }
  .liczba { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
  td :global(svg) { width: 14px; height: 14px; margin-left: 4px; vertical-align: -2px; }
  details summary { cursor: pointer; font-size: var(--fs-sm); color: var(--navy-700); margin-top: 6px; }
  blockquote { margin: 8px 0 0; padding-left: 12px; border-left: 3px solid var(--line-strong); font-size: var(--fs-sm); color: var(--ink-2); max-width: 520px; }
</style>
