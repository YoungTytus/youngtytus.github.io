---
import Uklad from '../../layouts/Uklad.astro';
import KartaKorzysci from '../../components/KartaKorzysci.astro';
import { socjal } from '../../lib/socjal.mjs';
import { aktPoEli, korzyscPoId } from '../../lib/model.mjs';
import { eliSlug, dataPL } from '../../lib/format.mjs';
export function getStaticPaths() {
 return (socjal()?.artykuly ?? []).map((a: any) => ({params:{id: a.id}, props: {art: a}}));
}
const a: any = Astro.props.art;
const akt = aktPoEli(a.eli);
const linked = a.korzysci.map((id: string) => korzyscPoId(id)).filter(Boolean);
const odwrotne = (socjal()?.artykuly ?? []).filter((v: any) => v.powiazane_artykuly.includes(a.id));
---
<Uklad tytul={`${a.eli}, art. ${a.artykul}`} opis={`Mapa art. ${a.artykul} aktu ${a.eli}, teksty jednostek, powiązania prawne, świadczenia.`}>
  <div class="page-head"><div class="wrap"><nav class="breadcrumb"><a href="/">Strona główna</a><span>/</span><a href="/przepisy/">Mapa przepisów</a><span>/</span><span>art. {a.artykul}</span></nav><p class="kicker">{a.eli} · {dataPL(a.stan_tekstu)}</p><h1>Art. {a.artykul}</h1><p class="lead">{akt?.tytul ?? a.eli}</p><p class="summary-note">Treść i rola jednostek pochodzą z mapowania projektu Socjal. Są informacyjne i nie zastępują aktualnego tekstu w Dzienniku Ustaw. <a class="link" href={`https://api.sejm.gov.pl/eli/acts/${a.eli}`} target="_blank" rel="noopener">Sprawdź źródło urzędowe ↗</a></p></div></div>
  <div class="wrap section detail-layout">
    <nav class="detail-nav"><a href="#jednostki">Jednostki</a><a href="#powiazania">Odesłania</a><a href="#korzysci">Korzyści</a></nav>
    <div class="detail-content">
      <section class="detail-section" id="jednostki"><h2>Jednostki przepisu ({a.jednostki.length})</h2>
        {a.jednostki.length === 0 && <p class="summary-note">W tej jednostce nie zapisano tekstu do publikacji.</p>}
        {a.jednostki.map((j: any) => <div class="related"><h3>{j.przepis}</h3><p style="white-space:pre-wrap">{j.tekst}</p><p class="muted">Identyfikator jednostki: {j.id}{j.rodzic && <> · Jednostka nadrzędna: {j.rodzic}</>}</p></div>)}
      </section>
      <section class="detail-section" id="powiazania"><h2>Powiązane artykuły</h2>
        {a.powiazane_artykuly.length === 0 && odwrotne.length === 0 && <p class="summary-note">Brak rozpoznanych odesłań między artykułami w dostępnych danych.</p>}
        {a.powiazane_artykuly.length > 0 && <><h3>Odesłania z tego artykułu</h3><ul>{a.powiazane_artykuly.map((id: string) => <li><a class="link" href={`/przepis/${id}/`}>{id.replaceAll('-', ' ')}</a></li>)}</ul></>}
        {odwrotne.length > 0 && <><h3>Artykuły odsyłające tutaj</h3><ul>{odwrotne.map((v: any) => <li><a class="link" href={`/przepis/${v.id}/`}>{v.eli} art. {v.artykul}</a></li>)}</ul></>}
        {(a.powiazane_akty ?? []).length > 0 && <><h3>Odesłania do innych aktów prawnych</h3><p class="summary-note">Odnośniki odtwarzają cytowania z mapowanego tekstu i nie rozstrzygają, czy wskazany akt nadal obowiązuje.</p><ul>{a.powiazane_akty.map((v: any) => <li><a class="link" href={`https://api.sejm.gov.pl/eli/acts/${v.eli}`} rel="noopener" target="_blank">{v.akt_tytul || v.eli}</a>{v.cytat && <span class="muted"> · {v.cytat}</span>}</li>)}</ul></>}
      </section>
      <section class="detail-section" id="korzysci"><h2>Powiązane karty ({linked.length})</h2>
        {linked.length ? <div class="cards">{linked.map((k: any) => <KartaKorzysci k={k} />)}</div> : <p class="summary-note">Brak bezpośredniego powiązania z kartą świadczenia. Nie oznacza to, że artykuł nie wpływa na uprawnienia.</p>}
      </section>
      <p><a class="text-link" href={`/akt/${eliSlug(a.eli)}/`}>Cały akt: {a.eli} →</a></p>
    </div>
  </div>
</Uklad>
