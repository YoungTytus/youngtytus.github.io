---
// Zmiany w danych (SPEC 4.6). Kontrakt strona-0.1 nie przenosi jeszcze historii wersji paczki,
// więc pokazujemy bieżącą wersję z manifestu; lista wydłuży się z kolejnymi paczkami.
import Uklad from '../../layouts/Uklad.astro';
import { dane } from '../../lib/model.mjs';
const d = dane();
const m = d.manifest;
const przyklady = d.korzysci.filter((k: any) => k._przyklad || k.ile.os_czasu.some((w: any) => w._przyklad)).length;
---
<Uklad tytul="Zmiany w danych" opis="Wersje danych Mapy Polskiego Socjalu: data wygenerowania, zakres i podsumowanie zmian." sekcja="zmiany">
  <div class="page-head">
    <div class="wrap">
      <nav class="breadcrumb" aria-label="Ścieżka nawigacji"><a href="/">Strona główna</a><span aria-hidden="true">/</span><span aria-current="page">Zmiany w danych</span></nav>
      <h1>Zmiany w danych</h1>
      <p class="lead">Każda wersja danych ma datę, wersję kodu i opis zmian. Dzięki temu wiadomo, od kiedy na stronie jest dana kwota.</p>
    </div>
  </div>
  <div class="wrap section prose">
    <div class="version">
      <p class="kicker">Bieżąca wersja</p>
      <h2 style="margin:0">{m.wygenerowano}</h2>
      <p>Kontrakt {m.kontrakt} · kod pipeline’u <code>{m.wersja_kodu}</code>{d.tryb === 'przyklad' && ' · dane przykładowe'}</p>
      <p>Korzyści: {d.korzysci.length} · akty: {d.akty.length} · zakres: {m.zakres.join(', ')}</p>
      {przyklady > 0 && <p>Rekordy z wartościami przykładowymi (jeszcze niewyliczanymi przez pipeline): {przyklady}.</p>}
    </div>
    <p class="todo"><strong>Do uzgodnienia z zespołem danych:</strong> podsumowanie różnic między wersjami (dodane, zmienione i usunięte rekordy) wymaga pola w manifeście albo osobnego pliku w paczce. Do tego czasu strona pokazuje tylko bieżącą wersję.</p>
  </div>
</Uklad>
