---
// /k/{slug} → /korzysc/{id}/ (adres kanoniczny jest stały, slug może się zmienić).
import { dane } from '../../lib/model.mjs';
export function getStaticPaths() {
  return dane().korzysci.map((k: any) => ({ params: { slug: k.slug }, props: { id: k.id, nazwa: k.nazwa } }));
}
const { id, nazwa } = Astro.props;
const cel = `/korzysc/${id}/`;
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <title>Przekierowanie: {nazwa}</title>
    <meta http-equiv="refresh" content={`0; url=${cel}`} />
    <link rel="canonical" href={new URL(cel, Astro.site).href} />
    <meta name="robots" content="noindex" />
  </head>
  <body><p>Strona przeniesiona: <a href={cel}>{nazwa}</a>.</p></body>
</html>
