---
import Kwota from './Kwota.astro';
import Dowod from './Dowod.astro';
import Zwijana from './Zwijana.astro';
import { dataLubBrak, typo, etykietaWariantu } from '../lib/format.mjs';
const { progi } = Astro.props;
const przepis = (s: string) => s.replace(/^arti?_(\d+)-pass_(\d+)$/, 'art. $1 ust. $2');
---
{progi?.length > 0 && <>
  <h3 id="progi">Progi i limity</h3>
  <p class="summary-note">Próg to warunek, który trzeba spełnić. Limit to najwyższa albo najniższa kwota, jaką dopuszcza przepis.</p>
  {progi.map((p: any, pi: number) => /\d/.test(p.wpisy.map((w: any) => w.wartosc ?? '').join('')) ? <>
    <h4>{typo(przepis(p.przepis))}</h4>
    <div class="table-wrap" tabindex="0"><table>
      <caption class="sr-only">{przepis(p.przepis)}</caption>
      <thead><tr><th scope="col">Wartość</th><th scope="col">Od</th><th scope="col">Do</th></tr></thead>
      <tbody>{p.wpisy.map((w: any, i: number) => <tr>
        <td>{w.wartosc && <Kwota wartosc={w.wartosc} href={`#prog-${pi}-${i}`} etykieta="źródło" />}{w.warianty?.map((v: any, vi: number) => <div>{etykietaWariantu(v, vi)}: <Kwota wartosc={v.wartosc} href={`#prog-${pi}-${i}`} etykieta="źródło" /></div>)}</td>
        <td>{dataLubBrak(w.od)}</td><td>{w.do === null ? 'bez daty końca' : dataLubBrak(w.do)}</td>
      </tr>)}</tbody>
    </table></div>
    <Zwijana tytul="Źródła" liczba={p.wpisy.length} poziom="h4" prog={0}>
      {p.wpisy.map((w: any, i: number) => <details id={`prog-${pi}-${i}`}><summary>{dataLubBrak(w.od)} · {typo(w.dowod.przepis)}</summary><Dowod dowod={w.dowod} /></details>)}
    </Zwijana>
  </> : <>
    {/* limit opisany słowami (bez liczby): zdanie z przepisem zamiast tabeli z pustymi datami */}
    <p id={`prog-${pi}-0`}><strong>{typo(przepis(p.przepis).split(/\s[—–-]\s/)[0])}:</strong> {typo(String(p.wpisy[0]?.wartosc ?? ''))} <span class="muted">({typo(p.wpisy[0]?.dowod?.przepis ?? '')})</span></p>
  </>)}
</>}
