---
import Ikona from './Ikona.astro';
import Kwota from './Kwota.astro';
import Status from './Status.astro';
import { czyKwotaWyliczona, dowodAktualnej, etykieta, kwotaPrezentowana } from '../lib/model.mjs';
import { typo, etykietaWariantu, opisUprawnionych } from '../lib/format.mjs';
interface Props { k: any; naglowek?: 'h2' | 'h3' }
const { k, naglowek = 'h3' } = Astro.props;
const H = naglowek;
const a = kwotaPrezentowana(k);
const dowod = dowodAktualnej(k);
const href = `/korzysc/${k.id}/${dowod.href}`;
const etykietaWartosci = czyKwotaWyliczona(k) ? 'Wyliczenie pomocnicze' : k.status === 'zamknieta' ? 'Kwota (archiwalna)' : 'Aktualna kwota';
---
<article class="card" data-id={k.id}>
  <div class="card-body">
    <div class="card-top">
      <span class="type">{etykieta('rodzaj_korzysci', k.rodzaj_korzysci)}</span>
      <Status status={k.status} />
    </div>
    <H><a href={`/korzysc/${k.id}/`} class="first-up">{k.nazwa}</a></H>
    <p class="komu"><span class="sr-only">Komu: </span>{typo(k.opis_prosty ?? opisUprawnionych(k.komu))}</p>
    {k.sytuacje.length > 0 && (
      <div class="card-sit">{k.sytuacje.map((s: string) => <a class="tag" href={`/sytuacja/${s}/`}>{etykieta('sytuacje', s)}</a>)}</div>
    )}
    <div class="card-value">
      <span class="label">{etykietaWartosci}</span>
      {a?.wartosc && <Kwota wartosc={a.wartosc} href={href} etykieta={dowod.etykieta} blok />}
      {!a?.wartosc && a?.warianty?.length && (
        <span class="kzd">
          <span class="warianty">{a.warianty.map((w: any, i: number) => <span class="kwota" title={etykietaWariantu(w, i)}>{i > 0 && <span aria-hidden="true">/ </span>}<span class="sr-only">{etykietaWariantu(w, i)}: </span>{typo(w.wartosc)}</span>)}</span>
          <a class="dowod dowod-blok" href={href}><span class="sr-only">Dowód: </span>{dowod.etykieta}</a>
        </span>
      )}
      {!a && <span class="muted">{k.ile.regula ? 'Reguła procentowa — szczegóły na karcie' : 'Nie ustalono (szczegóły na karcie)'}</span>}
      {k.flagi?.length > 0 && <span class="muted">Rekord wymaga przeglądu według eksportu.</span>}
    </div>
  </div>
  <div class="card-bottom" aria-hidden="true"><span>Warunki, historia i źródła</span><Ikona n="strzalka" /></div>
</article>
