---
import Ikona from './Ikona.astro';
import Status from './Status.astro';
import { czyKwotaWyliczona, etykieta, kwotaPrezentowana, limitPrezentowany } from '../lib/model.mjs';
import { typo, etykietaWariantu, opisUprawnionych } from '../lib/format.mjs';
interface Props { k: any; naglowek?: 'h2' | 'h3' }
const { k, naglowek = 'h3' } = Astro.props;
const H = naglowek;
const a = kwotaPrezentowana(k);
const limit = limitPrezentowany(k);
const niepieniezne = k.forma === 'niepieniezne' && !a && !limit;
const indywidualna = k.nieustalone?.find((n: any) => n.pole === 'ile.kwota_indywidualna');
const etykietaWartosci = czyKwotaWyliczona(k) ? 'Wyliczenie pomocnicze' : k.status === 'zamknieta' ? 'Kwota (archiwalna)'
  : limit ? (limit._rodzaj === 'maksimum' ? 'Kwota najwyżej' : 'Kwota co najmniej') : niepieniezne ? 'Forma pomocy' : 'Aktualna kwota';
---
<article class="card" data-id={k.id}>
  <div class="card-body">
    <div class="card-top">
      <span class="type">{etykieta('rodzaj_korzysci', k.rodzaj_korzysci)}{k.forma && k.forma !== 'nieustalona' && <> · {k.forma === 'pieniezne' ? 'pieniężne' : 'niepieniężne'}</>}</span>
      <Status status={k.status} />
    </div>
    <H><a href={`/korzysc/${k.id}/`} class="first-up">{k.nazwa}</a></H>
    {k.opis_prosty && <p class="opis">{typo(k.opis_prosty)}</p>}
    <p class="komu"><strong>Komu: </strong>{typo(opisUprawnionych(k.komu))}</p>
    {k.sytuacje.length > 0 && (
      <div class="card-sit">{k.sytuacje.map((s: string) => <a class="tag" href={`/sytuacja/${s}/`}>{etykieta('sytuacje', s)}</a>)}</div>
    )}
    <div class="card-value">
      <span class="label">{etykietaWartosci}</span>
      {/* Kafelek to skrót: kwota bez odznaki dowodu; dowód, przepis i historia są na stronie karty. */}
      {a?.wartosc && <span class="kwota-kafelek">{typo(a.wartosc)}</span>}
      {!a?.wartosc && a?.warianty?.length && (
        <span class="warianty">{a.warianty.map((w: any, i: number) => <span class="kwota-kafelek" title={etykietaWariantu(w, i)}>{i > 0 && <span aria-hidden="true">/ </span>}<span class="sr-only">{etykietaWariantu(w, i)}: </span>{typo(w.wartosc)}</span>)}</span>
      )}
      {!a && limit && <span class="kwota-kafelek">{typo(limit.wartosc)}</span>}
      {niepieniezne && <span class="forma-pomocy">Bez kwoty: rzecz, usługa albo miejsce</span>}
      {!a && !limit && !niepieniezne && <span class="muted">{indywidualna ? `Kwota indywidualna: ${indywidualna.powod}` : k.ile.regula ? 'Reguła procentowa — szczegóły na karcie' : 'Nie ustalono (szczegóły na karcie)'}</span>}
    </div>
  </div>
  <div class="card-bottom" aria-hidden="true"><span>Warunki, historia i źródła</span><Ikona n="strzalka" /></div>
</article>

<style>
  .forma-pomocy { display: block; font-weight: 600; color: var(--ink, inherit); margin-top: 4px; }
</style>
