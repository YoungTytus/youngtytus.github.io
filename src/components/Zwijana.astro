---
// Zwijana lista z nagłówkiem i liczbą pozycji (natywne <details>: klawiatura i czytniki ekranu bez skryptu).
// Krótkie listy (do `prog` pozycji) są domyślnie rozwinięte, długie — zwinięte.
interface Props { tytul: string; liczba: number; prog?: number; opis?: string; id?: string; poziom?: 'h3' | 'h4' }
const { tytul, liczba, prog = 3, opis, id, poziom = 'h3' } = Astro.props;
const H = poziom;
---
<details class="zwijana" id={id} open={liczba <= prog}>
  <summary>
    <H class="zwijana-tytul">{tytul}</H>
    <span class="zwijana-licznik" aria-label={`${liczba} pozycji`}>{liczba}</span>
    <svg class="zwijana-strzalka" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
  </summary>
  {opis && <p class="summary-note zwijana-opis">{opis}</p>}
  <div class="zwijana-tresc"><slot /></div>
</details>

<style>
  .zwijana { margin: 22px 0; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); }
  .zwijana > summary { display: flex; align-items: center; gap: 12px; min-height: 52px; padding: 10px 18px; cursor: pointer; list-style: none; border-radius: var(--radius); }
  .zwijana > summary::-webkit-details-marker { display: none; }
  .zwijana > summary:hover { background: var(--soft); }
  .zwijana > summary:focus-visible { outline: 3px solid var(--navy-800); outline-offset: 2px; }
  .zwijana-tytul { margin: 0; font-size: 1.05rem; flex: 1; }
  .zwijana-licznik { min-width: 28px; padding: 2px 9px; border-radius: 999px; background: var(--soft); border: 1px solid var(--line); font-size: .8rem; font-weight: 700; text-align: center; color: var(--ink-2); }
  .zwijana-strzalka { width: 20px; height: 20px; color: var(--ink-2); transition: transform .2s ease; flex-shrink: 0; }
  .zwijana[open] > summary .zwijana-strzalka { transform: rotate(180deg); }
  .zwijana-opis { margin: 0 18px 8px; }
  .zwijana-tresc { padding: 4px 18px 18px; }
  .zwijana-tresc > :first-child { margin-top: 0; }
  @media (prefers-reduced-motion: reduce) { .zwijana-strzalka { transition: none; } }
</style>
